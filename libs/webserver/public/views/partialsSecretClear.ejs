<%
	// Reusable CLEAR control for a write-only secret field (AI provider keys, 3CQS key, Telegram token).
	// A blank field KEEPS the saved secret, so removing one needs an explicit action — this renders the
	// hidden "<field>_clear" flag the save handler reads, and, only when a secret is currently saved, a
	// "[Clear]" link that marks it for deletion on the next save. Locals:
	//   field : the input's name/id (the flag is "<field>_clear")
	//   isSet : whether a secret is currently stored (the has_key / has_token / *_set flag)
	//   label : (optional) the "is set" wording, e.g. 'Password is set' (default 'A value is saved')
	// Pair with class="secretClearField" on the input so typing a new value cancels a pending clear.
%>
<% var _secretLabel = (typeof label !== 'undefined' && label) ? label : 'A value is saved'; %>
<input type="hidden" name="<%= field %>_clear" id="<%= field %>_clear" value="0">
<% if (isSet) { %>
	<div id="<%= field %>_clear_status" style="margin-top: 4px; font-size: var(--fs-body); color: var(--green-color, var(--color-success));">&#10003; <%= _secretLabel %> &nbsp;<span class="secretClearBtn" data-field="<%= field %>" style="cursor: pointer; color: var(--link-color); font-size: var(--fs-body);">[Clear]</span></div>
<% } %>
