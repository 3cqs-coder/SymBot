	function dealEdit(dealId) {

		const deal = dealTracker[dealId];

		//const dcaMaxOrder = deal['info']['safety_orders_max'];
		const dcaMaxOrder = deal['config']['dcaMaxOrder'];
		const dcaTakeProfitPercent = deal['config']['dcaTakeProfitPercent'];
		const profitCurrency = deal['config']['profitCurrency'];
		const dcaStopLossEnabled = deal['config']['dcaStopLossEnabled'];
		const dcaStopLossPercent = deal['config']['dcaStopLossPercent'];
		const dcaStopLossReference = deal['config']['dcaStopLossReference'];
		const dcaStopLossMoveBreakeven = deal['config']['dcaStopLossMoveBreakeven'];
		const dcaStopLossBreakevenTrigger = deal['config']['dcaStopLossBreakevenTrigger'];
		const dcaTrailingStopEnabled = deal['config']['dcaTrailingStopEnabled'];
		const dcaTrailingStopDistance = deal['config']['dcaTrailingStopDistance'];
		const dcaTrailingActivateProfit = deal['config']['dcaTrailingActivateProfit'];
		const dcaTrailingReplacesTakeProfit = deal['config']['dcaTrailingReplacesTakeProfit'];
		const dealLast = deal['config']['dealLast'];

		$('#dealEditId').val(dealId);
		$('#dcaMaxOrder').val(dcaMaxOrder);
		$('#dealLast').val(dealLast);
		$('#dcaTakeProfitPercent').val(dcaTakeProfitPercent);
		$('#dcaStopLossEnabled').val(String(dcaStopLossEnabled) === 'true' ? 'true' : 'false');
		$('#dcaStopLossPercent').val((dcaStopLossPercent != undefined && dcaStopLossPercent != null) ? dcaStopLossPercent : '');
		$('#dcaStopLossReference').val(String(dcaStopLossReference) === 'lastSafetyOrder' ? 'lastSafetyOrder' : 'average');
		$('#dcaStopLossMoveBreakeven').val(String(dcaStopLossMoveBreakeven) === 'true' ? 'true' : 'false');
		$('#dcaStopLossBreakevenTrigger').val((dcaStopLossBreakevenTrigger != undefined && dcaStopLossBreakevenTrigger != null) ? dcaStopLossBreakevenTrigger : '');
		$('#dcaTrailingStopEnabled').val(String(dcaTrailingStopEnabled) === 'true' ? 'true' : 'false');
		$('#dcaTrailingStopDistance').val((dcaTrailingStopDistance != undefined && dcaTrailingStopDistance != null) ? dcaTrailingStopDistance : '');
		$('#dcaTrailingActivateProfit').val((dcaTrailingActivateProfit != undefined && dcaTrailingActivateProfit != null) ? dcaTrailingActivateProfit : '');
		$('#dcaTrailingReplacesTakeProfit').val(String(dcaTrailingReplacesTakeProfit) === 'false' ? 'false' : 'true');

		$('#dealLast').prop('checked', false);
		$('#dealLast').switchToggle(false);

		if (!profitCurrency) {
			
			$('#profitCurrency').val('quote');
		}
		else {
			
			$('#profitCurrency').val(profitCurrency);
		}

		if (dealLast != undefined && dealLast != null && dealLast != '') {

			$('#dealLast').prop('checked', true);
			$('#dealLast').switchToggle(true);
		}

		// Cap the dialog width so the form doesn't sprawl on a wide monitor (the shared modal
		// defaults to 90%); stay within the viewport on small/mobile screens.
		openModal(modalId, '#boxDealEdit', 'Deal ID ' + dealId, '', '#modalDealEdit', Math.min(560, $(window).width() - 30));
  	}


