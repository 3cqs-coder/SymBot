	function renderAIContent(dealId) {

		const tz = getTimeZone(new Date());

		const header = 'AI Analysis ' + dealId;

		const orders = dealTracker[dealId]['orders'];
		const pair = dealTracker[dealId]['config']['pair'];
		const exchange = dealTracker[dealId]['config']['exchange'];

		// Show the animated mascot loader instantly (server-rendered markup, pure
		// CSS — no mount timing). openAiChat re-shows the same loader after the
		// fetch, so it's seamless with no white gap.
		openModal(modalId, '#modal', header, '');
		$('#modal').html(aiLoaderHtml('Analyzing this deal…'));

		// Params for OHLCV fetch
		const params = {
			exchange,
			pair,
			dealId,
			timeframe: '1h',
			limit: 200,
			timeZoneOffset: tz.offset
		};

		getAiAnalyzeDealPrompt(params).then(renderedTemplate => {

			openAiChat(modalId, 'modal', header, renderedTemplate);
		});
	}


	function getMarketOHLCV(params) {

		return new Promise((resolve) => {

			$.ajax({
				type: 'GET',
				url: './api/markets/ohlcv',
				data: params,
				dataType: 'json',
				timeout: 10000,
				success: function(data) {
					try {
						if (data && data.success && Array.isArray(data.data) && data.data.length > 0) {

							const ohlcv = data.data;

							let formatted = '';

							//formatted += "Date | Open | High | Low | Close | Volume\n";
							//formatted += "------------------------------------------------------\n";

							ohlcv.forEach(row => {

								const [ts, open, high, low, close, volume] = row;
								const date = dateConvertLocal(new Date(ts));

								formatted += `Date: ${date} | Close Price: $${close}\n`;

								//formatted += `${date} | ${open} | ${high} | ${low} | ${close} | ${volume}\n`;
							});

							//resolve(formatted);
							resolve(ohlcv);
						}
						else {

							resolve('');
						}
					}
					catch (err) {

						//alertBox('Error formatting OHLCV: ' + err.message);
						resolve('');
					}
				},
				error: function(err) {

					//alertBox('Error fetching OHLCV: ' + JSON.stringify(err));
					resolve('');
				}
			});
		});
	}


	function getAiAnalyzeDealPrompt(params) {

		return new Promise((resolve) => {

			$.ajax({
						type: 'GET',
						url: './api/ai/analyze_deal_prompt',
						data: params,
						dataType: 'json',
						success: function(data) {

							if (data.success) {

								resolve(data.data);
							}
							else {

								resolve(data.error);
							}
						},
						error: function(data) {

							// Some error in ajax call
							resolve('Error: ' + JSON.stringify(data));
					}
			});
		});
	}


