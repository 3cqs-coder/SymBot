	function processAddFunds(value, dealId) {

		if (isNaN(value)) {

			alertBox('Invalid amount entered', function() {});
  			return;
  		}

  		const requestBody = {

			volume: parseFloat(value),
		};

		$('#spinner-overlay').fadeIn(100);

		$.ajax({

			type: 'POST',
  			url: './api/deals/' + dealId + '/add_funds',
  			data: requestBody,
  			dataType: 'json',
  			success: function(data) {

				$('#spinner-overlay').fadeOut(100);

  				if (!data.success) {
  					alertBox('Unable to update deal: ' + data['data'], function() { getActiveDeals(); });
  				}
				else {
  					alertBox('Successfully added funds to: ' + dealId, function() { getActiveDeals(); });
  				}
  			},
  			error: function(data) {
  				// Some error in ajax call
  				$('#spinner-overlay').fadeOut(100);

	  			alertBox('Error: ' + JSON.stringify(data), function() { getActiveDeals(); });
  			},
  		});
	}


	function populateDeals(date, deals) {

		const maxMins = 2;

		let totalProfit = 0;
		let totalProjectedProfit = 0;
		let activeDeals = 0;
		let inDeals = 0;
		let dealDataErrors = 0;
		const selectedBot = $('#active-bot-filter').val();

		let msgBoxColor = '#386ec2';
		let profitTotalClass = 'profit-positive';

		let msgBox = '';

		let contentArr = [];
		let dealsErrorArr = [];

		dealTracker = {};
		csvDataArr = [];

		for (let i = 0; i < deals.length; i++) {

			if(!activeBots.includes(deals[i].botName)) {

				activeBots.push(deals[i].botName);

				$('#active-bot-filter').append('<option value="' + SymBot.UI.esc(deals[i].botName) + '">' + SymBot.UI.esc(deals[i].botName) + '</option>');
			}

			if(selectedBot != 'all' && deals[i].botName != selectedBot) {

				continue;
			}

			activeDeals++;

			let {
					add: { button: addFundsButtonDeal },
					edit: { button: editButtonDeal },
					cancel: { button: cancelButtonDeal },
					pause: { button: pauseButtonDeal },
					resume: { button: resumeButtonDeal },
					stop: { button: stopButtonDeal },
					ai: { button: aiButtonDeal },
					panic: { button: panicButtonDeal }
			} = actionButtons;

			let dealVolume = SymBot.UI.dealVolume(deals[i].orders);

			inDeals += dealVolume;

			let dealBackground = '';
			let profitPercClass = 'profit-positive';
			let pauseButtonId = 'pause';

			let dealCount;

			const deal = deals[i];
			const config = deal['config'];
			const dealId = deal['dealId'];
			const pause = deal['info']['pause'];
			const pauseBuy = deal['info']['pause_buy'];
			const pauseSell = deal['info']['pause_sell'];
			const pauseReason = deal['info']['pause_reason'] || '';
			const isSystemPaused = SymBot.UI.systemPauseInfo(pauseReason).isSystem;
			const dealError = deal['info']['error'];
			const lastUpdated = deal['info']['updated'];
			const botActive = deal['info']['bot_active'];
			// A just-resumed deal whose live figures haven't arrived yet (first price tick pending after a
			// restart). Live-only cells render "updating…" and the row shows a neutral pending health dot,
			// so the deal is visible immediately without showing a stale or fabricated live number.
			const awaiting = !!deal['info']['awaiting_live'];
			const profit = deal['info']['profit'];
			const profitBase = deal['info']['profit_base'];
			const profitQuoteProjected = Number(deal['info']['profit_quote_projected']);
			const profitPerc = deal['info']['profit_percentage'];
			const maxFunds = Math.round(deal['info']['max_funds']);
			const maxDeviation = deal['info']['max_deviation'];

			const duration = timeDiff(new Date(), new Date(deal['date']));
			const dealSym = getDealSym(deal['info']['pair'], deal['config']['profitCurrency']);

			let csvDealInfo = JSON.parse(JSON.stringify(deal.info));

			const manualProperties = {
				'started': dateConvertLocal(new Date(deal['date'])),
				'updated': dateConvertLocal(new Date(csvDealInfo.updated)),
				'duration': duration,
				'bot_id': deal['botId'],
				'bot_name': deal['info']['bot_name'],
				'deal_id': dealId,
				'profit_target_percentage': config['dcaTakeProfitPercent']
			};

			csvDealInfo = {
				...manualProperties,
				...Object.fromEntries(
					Object.entries(csvDealInfo).filter(([key]) => !(key in manualProperties))
				)
			};

			const reorderings = [
				{ after: 'active', property: 'bot_active' },
				{ after: 'profit_percentage', property: 'profit_target_percentage' }
			];

			reorderings.forEach(reordering => {

				csvDealInfo = reorderProperties(csvDealInfo, reordering.after, reordering.property);
			});

			delete csvDealInfo['estimates'];

			csvDataArr.push(csvDealInfo);

			if (!botActive) {

				stopButtonDeal = SymBot.UI.disabledStopButton();
			}

			if (pause || pauseBuy || pauseSell) {

				pauseButtonId = 'resume';
				pauseButtonDeal = resumeButtonDeal;

				// System-paused deals get a distinct orange tint to distinguish from manual pauses.
				// Use a translucent tint (not a solid dark color) so it layers over the themed row
				// background and stays readable in BOTH light and dark mode — a solid dark brown
				// (#7a4500) rendered dark-text-on-dark and was unreadable in light mode.
				if (isSystemPaused) {

					dealBackground = 'rgba(255,140,0,0.22)';
				}
			}

			if (!awaiting && profitPerc <= 0) {

				profitPercClass = 'profit-negative';
			}

			// Live health glyph for this deal (no user input; from state only).
			// Uses the shared SymBot.UI helper so instance and Hub render identically.
			const healthCell = SymBot.UI.dealHealthCell({
				profitPerc: profitPerc,
				soUsed: deal['info']['safety_orders_used'],
				soMax: config['dcaMaxOrder'],
				hasError: !!dealError,
				isPaused: !!(pause || pauseBuy || pauseSell),
				awaiting: awaiting
			});

			if (deal['info']['deal_max'] == 0) {

				deal['info']['deal_max'] = '&#8734;';
			}

			// Deal data issue
			if (isNaN(deal['info']['deal_count']) || (dealError != undefined && dealError != null && dealError != '')) {

				const maxSec = 30;

				// Wait to display any error since deal might be starting
				if (dealTrackerErrors[dealId] == undefined || dealTrackerErrors[dealId] == null) {

					dealTrackerErrors[dealId] = {};
					dealTrackerErrors[dealId]['date'] = new Date();

					continue;
				}
				else {

					let diffSec = (new Date().getTime() - new Date(dealTrackerErrors[dealId]['date']).getTime()) / 1000;

					if (diffSec > maxSec) {

						// Translucent amber tint (see system-pause note above) — readable in
						// light and dark mode, unlike the previous solid #B78225.
						dealBackground = 'rgba(183,130,37,0.28)';
						dealDataErrors++;
					}
					else {

						continue;
					}
				}
			}
			else {

				// Remove from deal error tracker
				delete dealTrackerErrors[dealId];
			}

			dealCount = deal['info']['deal_count'] + ' / ' + deal['info']['deal_max'];

			if (SymBot.UI.isDealStale(date, lastUpdated, maxMins)) {

				dealsErrorArr.push(dealId);
			}

			if (!isNaN(profit)) {

				totalProfit += profit;
			}

			if (!isNaN(profitQuoteProjected)) {

				totalProjectedProfit += profitQuoteProjected;
			}

			dealTracker[dealId] = SymBot.UI.buildDealTrackerEntry(deal);

			// "(+N)" counts only USER Add-Funds rungs — genuine additions beyond the configured max. An auto
			// partial-fill-credit re-uses an existing safety-order slot (it is already counted in "safety
			// orders used"), so it must NOT inflate this. Shared helper keeps the instance and Hub lists in sync.
			const addedFunds = SymBot.UI.addedFundsCount(deal['orders']);

			let safetyOrdersTotalDisplay = config['dcaMaxOrder'];

			if (addedFunds > 0) {

				safetyOrdersTotalDisplay += ' (+' + addedFunds + ')';
			}

			const estimates = JSON.stringify(deal.info.estimates || {})
				.replace(/&/g, '&amp;')
				.replace(/"/g, '&quot;')
				.replace(/'/g, '&#39;');

			// Raw values the Add Funds Estimator needs per deal (invested sum + base
			// qty from filled orders, current price, fee %, target %). Kept as data
			// attributes so the client bar reads them directly.
			const afSum = SymBot.UI.dealVolume(deal['orders']);
			const afQty = deal['orders'].filter(o => o.filled).reduce((a, o) => a + Number(o.qty || o.qtyFilled || 0), 0);
			const afPrice = Number(deal['info']['price_last']);
			const afFee = Number(config['exchangeFee']);
			const afTarget = Number(config['dcaTakeProfitPercent']);
			// Real cost basis + live profit % so the estimator's projected profit
			// reconciles exactly with the Profit % column (calculateProfit basis).
			const afAvg = Number(deal['info']['price_average']);
			const afProfit = Number(deal['info']['profit_percentage']);

			// Stop-loss annotation for the Target cell (#104a): the effective stop level, with a lock
			// once it moves to break-even. Shared helper (SymBot.UI.stopLossCell) so the instance and
			// Hub views stay identical. No new column, so tablesorter column indices are unaffected.
			const stopLossDisplay = SymBot.UI.stopLossCell(deal['info'], dealSym, convertNotation);

			contentArr.push('<tr style="background-color: ' + dealBackground + ';" data-dealid="' + dealId + '" data-pair="' + SymBot.UI.esc(deal['pair']) + '"  data-estimates="' + estimates + '" data-af-sum="' + afSum + '" data-af-qty="' + afQty + '" data-af-price="' + afPrice + '" data-af-fee="' + afFee + '" data-af-target="' + afTarget + '" data-af-avg="' + afAvg + '" data-af-profit="' + afProfit + '" data-af-sym="' + dealSym + '">');
			contentArr.push(healthCell);
			contentArr.push('<td class="cell-botname">' + SymBot.UI.esc(deal['info']['bot_name']) + '</td>');
			contentArr.push('<td class="dealid-cell">' + dealId + '</td>');
			contentArr.push('<td>' + SymBot.UI.esc(deal['pair']) + '</td>');
			contentArr.push('<td>' + duration + '</td>');
			contentArr.push('<td>' + SymBot.UI.pendingCell(awaiting, dealSym + convertNotation(deal['info']['price_last'])) + '</td>');
			contentArr.push('<td>' + dealSym + convertNotation(deal['info']['price_target']) + stopLossDisplay + '</td>');
			contentArr.push('<td>' + dealSym + dealVolume.toFixed(2) + '</td>')
			contentArr.push('<td class="' + profitPercClass + '">' + SymBot.UI.pendingCell(awaiting, dealSym + profit) + '</td>');
			contentArr.push('<td class="' + profitPercClass + '">' + SymBot.UI.pendingCell(awaiting, profitBase) + '</td>');
			contentArr.push('<td class="' + profitPercClass + '">' + SymBot.UI.pendingCell(awaiting, profitPerc + '%') + '</td>');
			contentArr.push('<td>' + SymBot.UI.pendingCell(awaiting, dealSym + profitQuoteProjected) + '</td>');
			contentArr.push('<td>' + config['dcaTakeProfitPercent'] + '%</td>');
			contentArr.push('<td>' + deal['info']['safety_orders_used'] + ' / ' + safetyOrdersTotalDisplay + '</td>');
			contentArr.push('<td>' + SymBot.UI.pendingCell(awaiting, dealSym + maxFunds) + '</td>')
			contentArr.push('<td>' + dealCount + '</td>');
			const pillContent = aiButtonDeal + editButtonDeal + panicButtonDeal + addFundsButtonDeal + pauseButtonDeal + cancelButtonDeal + (stopButtonDeal || '');
			contentArr.push('<td style="text-align: center;" data-pause="' + pause + '" data-pausebuy="' + pauseBuy + '" data-pausesell="' + pauseSell + '" data-pausereason="' + pauseReason + '" data-botid="' + deal['info']['bot_id'] + '" data-botname="' + SymBot.UI.esc(deal['info']['bot_name']) + '"><div class="pill-group" id="actions' + dealId + i + '">' + pillContent + '</div></td>');
			contentArr.push('</tr>');
		}

		if (totalProfit <= 0) {

			profitTotalClass = 'profit-negative';
		}

		$('#msgBox').empty();
		$('#botsDeals tbody').empty();

		if (dealsErrorArr.length > 0) {

			msgBox += '<div style="display: block;"><b>WARNING:</b> ' + dealsErrorArr.length + ' deals exceed last updated time of ' + maxMins + ' minutes. Check logs for more details.</div>';
		}

		if (dealDataErrors > 0) {

			msgBox += '<div style="display: block;"><b>WARNING:</b> ' + dealDataErrors + ' deals have errors or invalid data</div>';
		}

		if (msgBox != '') {

			$('#msgBox').css('color', msgBoxColor);
			$('#msgBox').html('<div style="display: block;">' + msgBox + '</div>');
		}

		$('#botsDeals tbody').append(contentArr.join(''));

		// Show the table only when there are rows to display; otherwise show a
		// clear "no active deals" message. This avoids the empty table rendering
		// with collapsed headers during load or when there are no deals.
		$('#dealsLoadingMsg').hide();

		if (contentArr.length > 0) {

			$('#dealsEmptyMsg').hide();
			$('#botsDeals').show();
		}
		else {

			$('#botsDeals').hide();
			$('#dealsEmptyMsg').show();
		}

		$('#totalProfit').removeClass('profit-positive profit-negative').addClass(profitTotalClass);
		const summarySym = deals.length > 0 ? getDealSym(deals[0]['info']['pair'], deals[0]['config']['profitCurrency']) : '$';
		$('#totalProfit').html(summarySym + totalProfit.toFixed(2));

		$('#inDeals').html(summarySym + inDeals.toFixed(2));
		$('#totalDeals').html(activeDeals);
		$('#projectedProfit').html(summarySym + (Math.round(totalProjectedProfit * 100) / 100).toFixed(2));

		$('#botsDeals').tablesorter().trigger('update');

		$(document).trigger('dealsTableUpdated');

		resizeBotsDeals();

		return csvDataArr;
	}


	const getCurrencySymbol = <%- getCurrencySymbol %>;

function getDealSym(pair, profitCurrency) { return SymBot.UI.dealSymbol(pair, profitCurrency, getCurrencySymbol); }




$(document).ready(function() {

		// Shared hover-tooltip machinery (SymBot.UI). Match the id EXACTLY against an action key
		// (NOT startsWith): several ids begin with an action key — e.g. the Add Funds Estimator
		// elements (addFundsEstToggle/addFundsEstBar/addFundsAmount) all start with "add" — and a
		// prefix match wrongly showed the row action's tooltip. Those elements carry their own native
		// title attributes, so exact matching leaves them intact.
		SymBot.UI.initTooltips({ resolve: function(id) {
			return Object.prototype.hasOwnProperty.call(actionButtons, id) ? actionButtons[id]['tooltip'] : null;
		}});


		$(document).on('mouseenter', '.dealid-cell', function(e) {

			try {
				
				let contentPriceTarget;
				let noAdd = false;

				const pair = $(this).closest('tr').attr('data-pair');
				const estimates = JSON.parse($(this).closest('tr').attr('data-estimates'));

				const [base, quote] = pair.split('/');
				const amountNet = convertNotation(estimates['amount_net']);
				const priceAvgNet = convertNotation(estimates['price_average_net']);
				const priceTargetNet = convertNotation(estimates['price_target_net']);
				const priceTargetChangePerc = convertNotation(estimates['price_target_change_percent']);

				if (priceTargetChangePerc > 0) {
					
					contentPriceTarget = `This is a ${Math.abs(priceTargetChangePerc)}% reduction from the current target price.`;
				}
				else {
					
					contentPriceTarget = `Adding funds may increase the target price for this deal.`;
					noAdd = true;
				}

				// Prevent duplicate tooltip
				if ($('.dynamic-tooltip').length) return;

				const tooltip = $(`
					<span class="toolTipStatic dynamic-tooltip" style="position: absolute;">
						<span class="toolTipText">
							Buying ${base} at the current market price using ${getCurrencySymbol(quote)}${amountNet} ${quote} may bring the average price bought to ${getCurrencySymbol(quote)}${priceAvgNet} and the new target take profit price to ${getCurrencySymbol(quote)}${priceTargetNet}. ${contentPriceTarget}
						</span>
					</span>
				`);

				if (noAdd) {
					
					tooltip.find('.toolTipText').addClass('tooltip-red');
				}

				// Add tooltip to body
				$('body').append(tooltip);

				const $cell = $(this);
				const cellOffset = $cell.offset();
				const cellHeight = $cell.outerHeight();
				const tooltipWidth = tooltip.outerWidth();
				const tooltipHeight = tooltip.outerHeight();

				// Clone the text into a temporary span to measure it
				const textClone = $('<span>')
					.text($cell.text().trim())
					.css({
						position: 'absolute',
						visibility: 'hidden',
						whiteSpace: 'nowrap',
						font: $cell.css('font'), // preserve font for accuracy
						fontSize: $cell.css('font-size'),
						fontWeight: $cell.css('font-weight'),
						fontFamily: $cell.css('font-family')
					})
					.appendTo('body');

				const textWidth = textClone.outerWidth();
			
				textClone.remove();

				// Final position
				const tooltipTop = cellOffset.top + cellHeight / 2 - tooltipHeight / 2;
				const tooltipLeft = cellOffset.left + textWidth + 6; // small buffer

				tooltip.css({
					top: tooltipTop + 'px',
					left: tooltipLeft + 'px',
					zIndex: 9999
				});
			}
			catch (e) {
	
				console.error(e);
			}
		});


		$(document).on('mouseleave', '.dealid-cell', function() {
			
			$('.dynamic-tooltip').remove();
		});


		$('#dealLast').simpleSwitch();
 
		$(window).resize(function() {

	 		resizeBotsDeals();
		});


		$('#formSubmitEdit').on('click', function(e) {

			e.preventDefault();

			const dealId = $('#dealEditId').val();
			const dealLast = $('#dealLast').prop('checked');
			const dcaMaxOrder = $('#dcaMaxOrder').val();
			const dcaTakeProfitPercent = $('#dcaTakeProfitPercent').val();
			const profitCurrency = $('#profitCurrency').val();
			const dcaStopLossEnabled = $('#dcaStopLossEnabled').val();
			const dcaStopLossPercent = $('#dcaStopLossPercent').val();
			const dcaStopLossReference = $('#dcaStopLossReference').val();
			const dcaStopLossMoveBreakeven = $('#dcaStopLossMoveBreakeven').val();
			const dcaStopLossBreakevenTrigger = $('#dcaStopLossBreakevenTrigger').val();
			const dcaTrailingStopEnabled = $('#dcaTrailingStopEnabled').val();
			const dcaTrailingStopDistance = $('#dcaTrailingStopDistance').val();
			const dcaTrailingActivateProfit = $('#dcaTrailingActivateProfit').val();
			const dcaTrailingReplacesTakeProfit = $('#dcaTrailingReplacesTakeProfit').val();

			let dataObj = {
							'dealLast': dealLast,
							'dcaMaxOrder': dcaMaxOrder,
							'dcaTakeProfitPercent': dcaTakeProfitPercent,
							'profitCurrency': profitCurrency,
							'dcaStopLossEnabled': dcaStopLossEnabled,
							'dcaStopLossPercent': dcaStopLossPercent,
							'dcaStopLossReference': dcaStopLossReference,
							'dcaStopLossMoveBreakeven': dcaStopLossMoveBreakeven,
							'dcaStopLossBreakevenTrigger': dcaStopLossBreakevenTrigger,
							'dcaTrailingStopEnabled': dcaTrailingStopEnabled,
							'dcaTrailingStopDistance': dcaTrailingStopDistance,
							'dcaTrailingActivateProfit': dcaTrailingActivateProfit,
							'dcaTrailingReplacesTakeProfit': dcaTrailingReplacesTakeProfit
						  };

			modalTracker[modalId].dialog('close');

			dealUpdate(dealId, dataObj);
		});


		// Numbers + a single decimal point only. Covers the deal-edit fields and the Add Funds
		// Estimator amount box (the '.' guard below blocks a second decimal point).
		$(document).on('keypress', '#formDealEdit input, #addFundsAmount', function(e) {

			const id = $(this).attr('id');
			const val = $('#' + id).val();

			const charCode = (e.which) ? e.which : e.keyCode;

			if (id == undefined || id == null) {

				return;
			}

			let regEx = /[^0-9\.]/g;

			if (id.toLowerCase() == 'dcamaxorder') {

				regEx = /[^0-9]/g;
			}

			if (charCode == 46 && (val.split('.').length - 1) > 0) {

				return false;
			}

			if (String.fromCharCode(charCode).match(regEx)) { return false; }
		});


		// Deal-edit modal "?" tooltips. The modal is a narrow, vertically-scrolling dialog, so a
		// bubble rendered inside it gets clipped (right edge, or the bottom on the last rows) and is
		// cramped if shrunk to fit. Render it as a FIXED-position bubble on hover so it escapes the
		// dialog's clipping entirely — kept at a readable width and flipped left/up to stay on screen.
		// (Hidden bubbles are display:none via CSS, so they never expand the dialog into a phantom
		// horizontal scrollbar.)
		$(document).on('mouseenter', '.dealEditModal .toolTip', function() {

			const tip = this.querySelector('.toolTipText');
			if (!tip) return;

			const r = this.getBoundingClientRect();
			const gap = 10, pad = 8, width = 340;

			// Show off-screen first so we can measure the wrapped height at the target width.
			tip.style.position = 'fixed';
			tip.style.margin = '0';
			tip.style.width = width + 'px';
			tip.style.maxWidth = 'calc(100vw - 16px)';
			tip.style.whiteSpace = 'pre-line';   // preserve authored line breaks in the hint text
			tip.style.left = '-9999px';
			tip.style.top = '0px';
			tip.style.display = 'block';
			tip.style.visibility = 'hidden';

			const tw = tip.offsetWidth, th = tip.offsetHeight;
			const vw = window.innerWidth, vh = window.innerHeight;

			let left = r.right + gap;
			const flipped = (left + tw > vw - pad);
			if (flipped) { left = r.left - gap - tw; }                 // no room right → flip left
			if (left < pad) { left = pad; }

			let top = r.top - 6;
			if (top + th > vh - pad) { top = vh - pad - th; }          // nudge up to stay on screen
			if (top < pad) { top = pad; }

			tip.style.left = left + 'px';
			tip.style.top = top + 'px';

			// Point the arrow at the "?": align it to the icon's vertical center, on the edge nearest
			// the icon. If the bubble had to be nudged so far the icon is outside its span, hide the
			// arrow rather than let it point at nothing.
			const arrowTop = Math.round((r.top + r.height / 2) - top - 8);
			if (arrowTop < 2 || arrowTop > th - 18) {
				tip.setAttribute('data-arrow', 'none');
			}
			else {
				tip.style.setProperty('--tip-arrow-top', arrowTop + 'px');
				tip.setAttribute('data-arrow', flipped ? 'left' : 'right');
			}

			tip.style.visibility = 'visible';
		});

		$(document).on('mouseleave', '.dealEditModal .toolTip', function() {

			const tip = this.querySelector('.toolTipText');
			if (tip) { tip.style.cssText = ''; tip.removeAttribute('data-arrow'); }   // back to CSS (display:none)
		});


		$('#botsDeals').tablesorter({

			widgets: [ 'saveSort', 'stickyHeaders', 'uitheme', 'columnSelector' ],
			widgetOptions: {
				saveSort: true,
				stickyHeaders_attachTo: '',
				columnSelector_mediaqueryHidden: true,
				columnSelector_mediaqueryName: 'Show Default',
				columnSelector_container: $('#botDealSelector')
			},
			durationLength : 4,
			durationLabels : '(?:years|year|y),(?:days|day|d),(?:hours|hour|h),(?:minutes|minute|min|m),(?:seconds|second|sec|s)',
			textExtraction: {

				0: function(node) {

					// Sort the Health column by its numeric rank (higher = needs
					// more attention), not by the emoji glyph.
					return node.getAttribute('data-health-rank') || '0';
				},
				10: function(node) {

					if (node.innerHTML.indexOf('%') != -1) {

						let val = stripHtml(node.innerHTML);
						return val.replace('%', '');
					}

					return node.innerHTML;
				},
				12: function(node) {

					if (node.innerHTML.indexOf('%') != -1) {

						let val = stripHtml(node.innerHTML);
						return val.replace('%', '');
					}

					return node.innerHTML;
				}
			},
			headers: {

				// Set "sorter : false" (no quotes) to disable the column
				4: {
					sorter: "duration"
				},
				5: {
					sorter: "currency"
				},
				6: {
					sorter: "currency"
				},
				7: {
					sorter: "currency"
				},
				8: {
					sorter: "currency"
				},
				11: {
					sorter: "currency"
				}
			}
		});

		// Rounded header corners must follow the first/last VISIBLE column, not the
		// first/last DOM cell (the column selector hides columns via a stylesheet
		// nth-child rule). Shared helper handles it on load + on columnUpdate.
		SymBot.UI.initHeaderCorners('#botsDeals');


		$('#csvDownload').click(function() {

			csvDownloadConfirm(csvDataArr);
		});


		$('#botDealSelectorShow').click(function() {

			$('.botDealSelectorWrapper').toggleClass('is-visible');
		});


		// ── Add Funds Estimator ────────────────────────────────────────────────
		// Per-deal hypothetical fill-price overrides, keyed by dealId.
		const addFundsPriceOverride = {};

		function addFundsActive() {

			return $('#addFundsEstBar').is(':visible') && parseFloat($('#addFundsAmount').val()) > 0;
		}

		// Count the decimal places a deal's own displayed price uses, so projected
		// values match the asset's real precision (e.g. 0.0623, not 0.06230424...).
		function priceDecimals(valStr) {

			const s = String(valStr);
			const dot = s.indexOf('.');
			return dot === -1 ? 0 : (s.length - dot - 1);
		}

		function fmtAtPrecision(value, refPriceStr, sym) {

			const decimals = Math.min(Math.max(priceDecimals(refPriceStr), 2), 12);
			const rounded = Number(value).toFixed(decimals);
			// Trim trailing zeros but keep at least 2 decimals for currency feel.
			return sym + convertNotation(rounded);
		}

		// Cell indexes in #botsDeals: Price = 5, Price Target = 6 (col 0 is Health).
		const AF_PRICE_COL = 5;
		const AF_TARGET_COL = 6;
		// Profit % column (Health 0, Bot 1, Deal 2, Pair 3, Duration 4, Price 5,
		// Target 6, Volume 7, Profit 8, Profit-base 9, Profit % 10).
		const AF_PROFIT_COL = 10;

		function clearAddFundsProjections() {

			$('#botsDeals tbody tr').each(function() {

				$(this).find('.af-proj').remove();
				$(this).find('.af-price-override-wrap').remove();
			});
		}

		// Wipe all per-deal fill-price overrides (on close, so a fresh open starts
		// at market price for every deal).
		function clearAddFundsOverrides() {

			for (const k in addFundsPriceOverride) { delete addFundsPriceOverride[k]; }
		}

		function renderAddFundsProjections() {

			const amount = parseFloat($('#addFundsAmount').val());

			$('#botsDeals tbody tr').each(function() {

				const $row = $(this);
				const dealId = $row.attr('data-dealid');

				if (!dealId) { return; }

				$row.find('.af-proj').remove();

				const sym = $row.attr('data-af-sym') || '$';
				const marketPrice = parseFloat($row.attr('data-af-price'));
				const override = addFundsPriceOverride[dealId];
				const fillPrice = (override != null && isFinite(override) && override > 0) ? override : marketPrice;

				if (!(amount > 0)) { return; }

				const est = computeAddFundsForward({
					sum: parseFloat($row.attr('data-af-sum')),
					qtySum: parseFloat($row.attr('data-af-qty')),
					addAmount: amount,
					addPrice: fillPrice,
					price: marketPrice,
					exchangeFee: parseFloat($row.attr('data-af-fee')),
					targetProfitPercent: parseFloat($row.attr('data-af-target')),
					// Projected-profit inputs: real basis + live column values so the
					// projection reconciles with the Profit % column exactly. Profit is
					// always evaluated at the current MARKET price, never the fill price.
					marketPrice: marketPrice,
					currentAverageReal: parseFloat($row.attr('data-af-avg')),
					currentProfitPercent: parseFloat($row.attr('data-af-profit'))
				});

				if (!est.valid) { return; }

				const $priceCell = $row.find('td').eq(AF_PRICE_COL);
				const $targetCell = $row.find('td').eq(AF_TARGET_COL);

				// Reference precision from the deal's own displayed price (strip the
				// currency symbol) so projections match the asset's tick size.
				const refPriceStr = ($priceCell.clone().children().remove().end().text() || '').replace(/[^0-9.]/g, '');

				const isOverridden = (override != null && isFinite(override) && override > 0);
				const projClass = isOverridden ? 'af-proj af-proj-override' : 'af-proj';

				// New average shown under the Price cell; new target under Target cell.
				const overrideTag = isOverridden
					? ' <span class="af-override-tag">@ ' + convertNotation(override) + '</span>'
					: '';

				$priceCell.append(
					'<div class="' + projClass + '">&rarr; avg ' + fmtAtPrecision(est.average_price_net, refPriceStr, sym) +
					overrideTag + '</div>'
				);

				const tChange = est.target_price_change_percent;
				const tChangeStr = (tChange > 0 ? ' (-' + tChange.toFixed(2) + '%)' : '');

				$targetCell.append(
					'<div class="' + projClass + '">&rarr; ' + fmtAtPrecision(est.target_price_net, refPriceStr, sym) +
					'<span class="af-proj-delta">' + tChangeStr + '</span></div>'
				);

				// Projected profit % at current market after the add. Reconciles with
				// the Profit % column by construction (basis-anchored + self-calibrated
				// deduction in computeAddFundsForward). Only shown when valid.
				if (est.projected_profit_valid) {

					const $profitCell = $row.find('td').eq(AF_PROFIT_COL);
					const pChange = est.projected_profit_change_percent;

					// Positive change = profit improved (less negative / more positive).
					const pChangeStr = (isFinite(pChange) && Math.abs(pChange) >= 0.005)
						? ' (' + (pChange > 0 ? '+' : '') + pChange.toFixed(2) + '%)'
						: '';

					$profitCell.append(
						'<div class="' + projClass + '">&rarr; ' + est.projected_profit_percent.toFixed(2) + '%' +
						'<span class="af-proj-delta">' + pChangeStr + '</span></div>'
					);
				}
			});
		}

		function refreshAddFunds() {

			if (addFundsActive()) {

				renderAddFundsProjections();
			}
			else {

				clearAddFundsProjections();
			}
		}

		// Toggle the bar from the toolbar.
		$('#addFundsEstToggle').click(function() {

			const $bar = $('#addFundsEstBar');

			if ($bar.is(':visible')) {

				$bar.hide();
				clearAddFundsOverrides();
				clearAddFundsProjections();
			}
			else {

				$bar.show();
				$('#addFundsAmount').focus();
				refreshAddFunds();
			}
		});

		// Close (×) hides and reverts.
		$('#addFundsClose').click(function() {

			$('#addFundsEstBar').hide();
			$('#addFundsAmount').val('');
			clearAddFundsOverrides();
			clearAddFundsProjections();
		});

		// Realtime as the user types the amount.
		$('#addFundsAmount').on('input', function() {

			refreshAddFunds();
		});

		// Per-deal price override: click a deal's Price cell (while the bar is
		// active) to reveal a small fill-price field for that row only.
		$(document).on('click', '#botsDeals tbody tr td', function(e) {

			if (!addFundsActive()) { return; }
			if ($(this).index() !== AF_PRICE_COL) { return; }
			if ($(e.target).closest('.af-price-override-wrap').length) { return; }

			const $row = $(this).closest('tr');
			const dealId = $row.attr('data-dealid');

			if ($(this).find('.af-price-override-wrap').length) { return; }

			e.stopPropagation();

			const current = addFundsPriceOverride[dealId] != null ? addFundsPriceOverride[dealId] : '';

			const $wrap = $('<span class="af-price-override-wrap"></span>');
			const $inp = $('<input type="number" step="any" min="0" class="form-field af-price-override" placeholder="fill price">').val(current);
			const $clr = $('<span class="af-override-clear" title="Use market price">&times;</span>');

			$wrap.append($inp).append($clr);
			$(this).append($wrap);
			$inp.focus();

			$inp.on('click', function(ev) { ev.stopPropagation(); });

			$inp.on('input', function() {

				const v = parseFloat($(this).val());

				if (isFinite(v) && v > 0) { addFundsPriceOverride[dealId] = v; }
				else { delete addFundsPriceOverride[dealId]; }

				renderAddFundsProjections();
			});

			$clr.on('click', function(ev) {

				ev.stopPropagation();
				delete addFundsPriceOverride[dealId];
				renderAddFundsProjections();
			});
		});

		// Re-apply projections after each table refresh (rows get rebuilt).
		$(document).on('dealsTableUpdated', function() {

			refreshAddFunds();
		});


		// Row click — data cols open order history or trading view
		$(document).on('click', '#botsDeals tbody tr td', function() {

			let col = $(this).index();

			// When the Add Funds Estimator is active, the Price cell is used to set
			// a per-deal fill-price override — don't open the order-history modal.
			if (typeof addFundsActive === 'function' && addFundsActive() && col === AF_PRICE_COL) {

				return;
			}

			let row = $(this).closest('tr');
			let content = $(this).text();
			let colCount = $(row).find('td').length;

			if (col == 3) {

				// Deal chart (Pair column; col 0 is Health) — opens the deal-overlay chart with a
				// TradingView tab. Falls back to the plain TradingView widget if the component is absent.
				let pair = content;
				let dealId = row.data('dealid');
				let exchange = (dealTracker[dealId] && dealTracker[dealId]['config']) ? dealTracker[dealId]['config']['exchange'] : '';

				if (window.SymBot && SymBot.DealChart) {

					SymBot.DealChart.open(dealId, { 'modalId': modalId, 'pair': pair, 'exchange': exchange });
				}
				else {

					showTradingView(modalId, 'modal', false, false, pair, exchange);
				}
			}
			else if (col < colCount - 1) {

				// Order History — any data column
				let dealId = row.data('dealid');

				if (dealTracker[dealId] == undefined || dealTracker[dealId] == null) {

					return;
				}

				showOrderHistory(modalId, dealId, dealTracker[dealId]['info']['active'], dealTracker[dealId]['orders'], dealTracker[dealId]['info']['pair']);
			}
		});

		// Pill button clicks — identified by pill-btn class on the clicked span
		$(document).on('click', '#botsDeals .pill-btn', function(e) {

			e.stopPropagation();

			let $btn = $(this);
			let $td  = $btn.closest('td');
			let row  = $btn.closest('tr');
			let dealId   = row.data('dealid');
			let pair     = row.data('pair');
			let btnTitle = $btn.attr('title');

			if (btnTitle === 'AI Analyze deal') {

				if (dealTracker[dealId] == undefined || dealTracker[dealId] == null) return;

				renderAIContent(dealId);
			}
			else if (btnTitle === 'Edit deal') {

				if (dealId) dealEdit(dealId);
			}
			else if (btnTitle === 'Close deal') {

				if (dealId) panicSellConfirm(dealId);
			}
			else if (btnTitle === 'Add funds to deal') {

				if (dealId) showAddFunds(pair, dealId);
			}
			else if (btnTitle === 'Pause deal' || btnTitle === 'Resume deal') {

				if (dealId) pauseDeal(pair, dealId, $td.data('pause'), $td.data('pausebuy'), $td.data('pausesell'), $td.data('pausereason'));
			}
			else if (btnTitle === 'Cancel deal') {

				if (dealId) cancelDeal(pair, dealId);
			}
			else if (btnTitle === 'Stop bot') {

				let botId   = $td.data('botid');
				let botName = $td.data('botname');

				if (botId) stopBotConfirm(botName, $btn, { 'bot_id': botId });
			}
		});

		$('#active-bot-filter').change(() => {

			getActiveDeals();
		})
		
		getActiveDeals();

	});


</script>

