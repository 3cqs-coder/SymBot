	function processCancelDeal(dealId) {

		const requestBody = {};

		$('#spinner-overlay').fadeIn(100);

		$.ajax({

			type: 'POST',
	  		url: './api/deals/' + dealId + '/cancel',
	  		data: requestBody,
	  		dataType: 'json',
	  		success: function(data) {

				$('#spinner-overlay').fadeOut(100);

					if (!data.success) {
						alertBox('Unable to cancel deal: ' + data['data'], function() { getActiveDeals(); });
					}
				else {
					alertBox('Successfully canceled deal: ' + dealId, function() { getActiveDeals(); });
				}
			},
			error: function(data) {
				// Some error in ajax call
				$('#spinner-overlay').fadeOut(100);

				alertBox('Error: ' + JSON.stringify(data), function() { getActiveDeals(); });
			},
		});
	}


