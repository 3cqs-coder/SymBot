	var cbCountdownTimer = null;

	function updateCircuitBreakerBanner(cb) {

		const $banner = $('#circuitBreakerBanner');

		if (!cb || !cb.active) {

			$banner.hide();
			if (cbCountdownTimer) { clearInterval(cbCountdownTimer); cbCountdownTimer = null; }
			return;
		}

		$('#cbReason').text(cb.reason);
		$banner.show();

		// Countdown timer
		if (cbCountdownTimer) clearInterval(cbCountdownTimer);

		function updateCountdown() {

			const secsLeft = cb.clears_at ? Math.max(0, Math.round((cb.clears_at - Date.now()) / 1000)) : 0;
			$('#cbCountdown').text(secsLeft + 's');

			if (secsLeft <= 0) {
				clearInterval(cbCountdownTimer);
				cbCountdownTimer = null;
			}
		}

		updateCountdown();
		cbCountdownTimer = setInterval(updateCountdown, 1000);
	}


	function updatePortfolioBar(portfolio) {

		if (!portfolio) {

			$('#portfolioRiskBar').hide();
			return;
		}

		// Currency symbol — use first configured currency as the quote
		const currencies  = portfolio.balance_currencies || [];
		const quoteCcy    = currencies[0] || 'USD';
		const sym         = (typeof getCurrencySymbol === 'function') ? getCurrencySymbol(quoteCcy) : '$';

		// Portfolio total
		$('#portfolioTotal').text(sym + (portfolio.portfolio_total || 0).toFixed(2) + ' ' + quoteCcy);

		// Max Funds
		$('#portfolioMaxFunds').text(sym + (portfolio.total_max_funds || 0).toFixed(2));

		// Risk % with colour coding
		const risk = portfolio.risk_percent;
		let riskClass = 'portfolio-risk-low';

		if (risk !== null && risk !== undefined) {

			if (risk >= 90)      riskClass = 'portfolio-risk-high';
			else if (risk >= 70) riskClass = 'portfolio-risk-mid';
		}

		$('#portfolioRisk')
			.attr('class', riskClass)
			.text(risk !== null && risk !== undefined ? risk + '%' : 'N/A');

		// Balance age indicator — hidden in sandbox mode, shows freshness in live mode
		if (portfolio.is_sandbox) {

			$('#portfolioBalanceAge').text('Sandbox');
		}
		else if (portfolio.balance_updated) {

			const ageSecs = Math.round((Date.now() - new Date(portfolio.balance_updated).getTime()) / 1000);
			const ageMins = Math.floor(ageSecs / 60);
			const ageText = ageMins > 0 ? ageMins + 'm ago' : ageSecs + 's ago';
			$('#portfolioBalanceAge').text('Balance: ' + ageText);
		}
		else {

			$('#portfolioBalanceAge').text('');
		}

		$('#portfolioRiskBar').show();
	}


