	function pauseDeal(pair, dealId, pause, pauseBuy, pauseSell, pauseReason) {

		let pairSplit = pair.split('/');
		let quote = pairSplit[1];

		const isSystemPaused = pauseReason === 'order_verify_buy' || pauseReason === 'order_verify_sell';
		const systemPauseType = pauseReason === 'order_verify_buy' ? 'buy order' : 'sell order';
		const systemWarning = isSystemPaused
			? '<div style="font-size: 1.0rem; padding: 8px; margin-bottom: 10px; background: rgba(255,140,0,0.15); border-left: 3px solid #ffa000; border-radius: 2px;">' +
			  '<b>⚠ System paused:</b> This deal was automatically paused due to a ' + systemPauseType + ' verification failure. ' +
			  'Resuming manually may cause issues if the underlying problem has not resolved.</div>'
			: '';

		$.confirm({
			title: false,
			boxWidth: "50%",
			useBootstrap: false,
	 		content: `<div style="font-size: 1.2rem; text-align: left;">Pause / Resume deal ${dealId}?<br><br>
			<form action="" style="display: inline;">
			${systemWarning}
			This will pause or resume any further buying and / or selling for this deal
			<br><br>

			<input id="dealPauseBuy" name="dealPauseBuy" type=checkbox class="form-field"> &nbsp; <b>Pause Buy</b>
			<br>
			<input id="dealPauseSell" name="dealPauseSell" type=checkbox class="form-field"> &nbsp; <b>Pause Sell</b>

			<br><br>
			<input type="checkbox" id="confirmBox" class="form-field" style="width: 20px;" /> <b>Check the box to confirm <span style="color: var(--color-danger);">PAUSE / RESUME</span> deal</b>
			</form>
			</div>`,
			buttons: {
				  formSubmit: {
					  btnClass: 'btn-default',
					  text: '<div style="color: var(--color-danger);">Pause / Resume Deal</div>',
					  action: function() {

						const inputValue = parseFloat($('#confirmNum').val());
						const confirmBox = $('#confirmBox').prop('checked');

						const pauseBuy = convertBoolean($('#dealPauseBuy').prop('checked'), false);
						const pauseSell = convertBoolean($('#dealPauseSell').prop('checked'), false);

						if (!confirmBox) {

							alertBox('You must check the box to confirm pause / resume deal', function() {});
						}
						else {

							processPauseDeal(dealId, pauseBuy, pauseSell);
				 		}
			  		},
				},
		  		cancel: {
			 		btnClass: 'btn-default',
			  		text: '<div style="color: var(--color-neutral);">Cancel</div>',
			  		action: function() {},
				},
			},
			onOpenBefore: function () {
 
				// Set both buy and sell to true
				if (pause) {

					pauseBuy = true;
					pauseSell = true;
				}

				$('#dealPauseBuy').simpleSwitch();
				$('#dealPauseSell').simpleSwitch();

				$('#dealPauseBuy').prop('checked', pauseBuy);
				$('#dealPauseBuy').switchToggle(pauseBuy);

				$('#dealPauseSell').prop('checked', pauseSell);
				$('#dealPauseSell').switchToggle(pauseSell);
			},
	  		onContentReady: function() {

				$('#confirmBox').prop('checked', false);

				let jc = this;
		  		this.$content.find("form").on("submit", function(e) {
					e.preventDefault();
			  		jc.$$formSubmit.trigger("click");
		  		});
	  		},
  		});
	}


	function processPauseDeal(dealId, pauseBuy, pauseSell) {

		const requestBody = {

			pauseBuy: pauseBuy,
			pauseSell: pauseSell
		};

		$('#spinner-overlay').fadeIn(100);

		$.ajax({

			type: 'POST',
	  		url: './api/deals/' + dealId + '/pause',
	  		data: requestBody,
	  		dataType: 'json',
	  		success: function(data) {

				$('#spinner-overlay').fadeOut(100);

				if (!data.success) {
					alertBox('Unable to update pause status for deal: ' + data['data'], function() { getActiveDeals(); });
				}
				else {
					alertBox('Successfully updated pause status for deal: ' + dealId, function() { getActiveDeals(); });
				}
			},
			error: function(data) {
				// Some error in ajax call
				$('#spinner-overlay').fadeOut(100);

				alertBox('Error: ' + JSON.stringify(data), function() { getActiveDeals(); });
			},
		});
	}


