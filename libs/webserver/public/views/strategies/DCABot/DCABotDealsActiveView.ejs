	function setReloadTimeout() {

		if (timeOutId) {

			clearTimeout(timeOutId);
		}

		timeOutId = setTimeout(() => {

			// Keep refreshing normally so estimates stay realtime (important in a
			// volatile market). Only defer a refresh when the user is actively
			// typing in a per-deal fill-price field, so it isn't yanked out from
			// under them mid-entry. Resumes immediately once they leave the field.
			if ($('.af-price-override:focus').length > 0) {

				setReloadTimeout();
				return;
			}

			getActiveDeals();

		}, 5000);
	}


