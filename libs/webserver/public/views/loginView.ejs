<%- include('./partialsHeaderView', { isLoginPage: true }); %>

<script>

	$(document).ready(function () {

		$('#password').focus();
	});

</script>

<main>

	<div class="loginWrap">

		<div class="card loginCard">

			<div class="loginBrand"><%= appData.name_display || appData.name %></div>
			<div class="section-sub">Log in to your instance.</div>

			<form class="loginForm" method="POST" autocomplete="off" action="./login">

				<div class="formRow">
					<label class="fieldLabel" for="username">Username</label>
					<input id="username" name="username" type="text" autocomplete="off" class="form-field">
					<div class="loginHint">Leave blank to sign in as the owner.</div>
				</div>

				<div class="formRow">
					<label class="fieldLabel" for="password">Password</label>
					<input id="password" name="password" type="password" class="form-field">
				</div>

				<button type="submit" class="loginBtn">Log in</button>

			</form>

		</div>

	</div>


</main>


<%- include('./partialsFooterView'); %>
