<%- include('./partialsHeaderView'); %>

<script>

	const token = '<%= token %>';
	const telegramEnabled = '<%= appData['telegram_enabled_config'] %>';
	const signals3CQSEnabled = '<%= appData['signals_3cqs_enabled'] %>';
	const configMode = '<%= appData['config_mode'] %>';
	const pairButtons = <%- JSON.stringify(appData.bots['pair_buttons'] || []).replace(/</g, '\\u003c') %>;
	const pairBlackList = <%- JSON.stringify(appData.bots['pair_blacklist'] || []).replace(/</g, '\\u003c') %>;

	function convertBoolean(param) {

		let paramBool;

		if (param) {

			paramBool = param.toLowerCase() === 'false' ? false : true;
		}

		return paramBool;
	}


	function genUUIDv4() {

		let dt = new Date().getTime();

		let uuid = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {

			let r = (dt + Math.random()*16)%16 | 0;
			dt = Math.floor(dt/16);
			return (c=='x' ? r :(r&0x3|0x8)).toString(16);
		});

		return uuid;
	}


	function generateApiKey() {

		$.confirm({

			title: false,
			boxWidth: '50%',
			useBootstrap: false,
			content: '<div style="font-size: var(--fs-dialog-title); text-align: left;"><b>WARNING:</b> This will replace your existing API key after you update the configuration. Copy your key and store in a safe place since it will not be displayed again.</div>',
			buttons: {

						ok: {
								btnClass: 'btn-default',
								text: '<div style="color: var(--color-success);">Generate API Key</div>',
								action: function () {

									const uuid = genUUIDv4();

									$('#apikey').val(uuid);
								}
							 },
						 cancel: {
									 btnClass: 'btn-default',
									 text: '<div style="color: #000000;">Cancel</div>',	
									 action: function () { }
								 }
					 }
		});
	}

	// ── Local ⇄ UTC helpers (day-of-week accurate; a local time can land on a
	// different UTC weekday near midnight, so weekdays are remapped by resolving an
	// actual instant rather than only shifting the clock). ──
	function bkpTimeLocalToUtc(lh, lm) { const d = new Date(); d.setHours(lh, lm, 0, 0); return { h: d.getUTCHours(), m: d.getUTCMinutes() }; }
	function bkpTimeUtcToLocal(uh, um) { const d = new Date(); d.setUTCHours(uh, um, 0, 0); return { h: d.getHours(), m: d.getMinutes() }; }
	function bkpLocalDowToUtc(dow, lh, lm) { const d = new Date(); d.setHours(lh, lm, 0, 0); let g = 0; while (d.getDay() !== dow && g++ < 8) { d.setDate(d.getDate() + 1); } return d.getUTCDay(); }
	function bkpUtcDowToLocal(udow, uh, um) { const d = new Date(); d.setUTCHours(uh, um, 0, 0); let g = 0; while (d.getUTCDay() !== udow && g++ < 8) { d.setUTCDate(d.getUTCDate() + 1); } return d.getDay(); }
	function bkpDayDelta(lh, lm) { const d = new Date(); d.setHours(lh, lm, 0, 0); let delta = d.getUTCDay() - d.getDay(); if (delta === 6) { delta = -1; } else if (delta === -6) { delta = 1; } return delta; }


	function getBackupScheduleCron() {

		let success = true;
		const checkedDays = [];

		$('#backup_days input[type="checkbox"]:checked').each(function () {
	
			checkedDays.push($(this).val());
		});

		let time = $('#backup_time').val().trim(); // "HH:MM"
		let dayOfMonth = $('#backup_day_month').val().trim(); // optional
		const maxBackups = $('#backup_max').val().trim();
		const password = $('#backup_password').val().trim();
		const isEnabled = $('#toggleBackup').is(':checked');

		let cronSchedule = '';
		let localTime = '';
		let utcTime = '';
		let daysOfWeek = [];
		let timezone = '';

		if (isEnabled) {

			if (!/^\d{1,2}:\d{2}$/.test(time)) {
	
				success = false;

				alertBox("Backup time must be in HH:MM format");
			}

			// A password is required to enable backups, but a blank field is allowed when one is already
			// stored — the server never sends the saved password to the browser, so re-saving without
			// retyping preserves it (the field only needs a value when setting or changing it).
			const backupPasswordAlreadySet = <%= services['cron_backup'] && services['cron_backup']['password_set'] ? 'true' : 'false' %>;

			if ((password == undefined || password == null || password == '') && !backupPasswordAlreadySet) {

				success = false;

				alertBox("Backup password must be entered");
			}

			if (checkedDays.length == 0) {

				success = false;

				alertBox("Please select at least one day for backups");
			}
		}

		if (/^\d{1,2}:\d{2}$/.test(time)) {

			const [localHour, localMinute] = time.split(':').map(Number);
			const dst = $('#backup_dst').is(':checked');

			if (dst) {

				// DST-aware: store the LOCAL wall time as-is; the backend anchors the schedule
				// to this timezone so it stays fixed to that local time across daylight-saving.
				const cronDayOfMonth = (dayOfMonth && /^\d+$/.test(dayOfMonth)) ? String(Number(dayOfMonth)) : '*';
				const daySet = {};
				checkedDays.forEach(function (d) { daySet[Number(d)] = true; });
				const days = Object.keys(daySet).map(Number).sort(function (a, b) { return a - b; });
				const cronDayOfWeek = days.length ? days.join(',') : '*';

				cronSchedule = `${localMinute} ${localHour} ${cronDayOfMonth} * ${cronDayOfWeek}`;
				localTime = `${String(localHour).padStart(2, '0')}:${String(localMinute).padStart(2, '0')}`;
				utcTime = '';
				daysOfWeek = checkedDays;
				timezone = getBackupTz();
			}
			else {

				// Convert local time + local weekdays to UTC (day-of-week accurate).
				const utc = bkpTimeLocalToUtc(localHour, localMinute);
				const dayDelta = bkpDayDelta(localHour, localMinute);

				const cronMinute = utc.m;
				const cronHour = utc.h;

				let cronDayOfMonth = '*';
				if (dayOfMonth) {
					let dom = Number(dayOfMonth) + dayDelta;
					if (dom < 1) { dom = 31; } else if (dom > 31) { dom = 1; }
					cronDayOfMonth = String(dom);
				}
				const cronMonth = '*';

				// Remap each checked local weekday to the UTC weekday it falls on at this time.
				const utcDaySet = {};
				checkedDays.forEach(function (d) { utcDaySet[bkpLocalDowToUtc(Number(d), localHour, localMinute)] = true; });
				const utcDays = Object.keys(utcDaySet).map(Number).sort(function (a, b) { return a - b; });
				const cronDayOfWeek = utcDays.length ? utcDays.join(',') : '*';

				cronSchedule = `${cronMinute} ${cronHour} ${cronDayOfMonth} ${cronMonth} ${cronDayOfWeek}`;
				localTime = `${String(localHour).padStart(2, '0')}:${String(localMinute).padStart(2, '0')}`;
				utcTime = `${String(cronHour).padStart(2, '0')}:${String(cronMinute).padStart(2, '0')}`;
				daysOfWeek = checkedDays;
			}
		}

		return {
			success,
			cronSchedule,
			localTime,
			utcTime,
			daysOfWeek,
			timezone,
			maxBackups,
			password,
			enabled: isEnabled
		}
	}

	// The browser's IANA timezone via the shared header helper, for DST-aware backups.
	function getBackupTz() { try { if (typeof getTimeZone === 'function') { const t = getTimeZone().timezone; if (t) { return t; } } } catch (e) {} try { return Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC'; } catch (e) { return 'UTC'; } }

	// A short timezone label (e.g. "EST", "GMT+1") for the current date — mirrors the schedules view.
	function tzAbbrev(tz) { return SymBot.UI.tzAbbrev(tz); }
	// Show which timezone the backup time is interpreted in, next to the Time field — like the
	// schedules view. When "Keep fixed to my local time" is on the backup runs in your local zone;
	// otherwise the time is stored in UTC.
	function updateBackupTzLabel() {
		const el = $('#backup_tz_label');
		if (!el.length) { return; }
		// The Time field ALWAYS shows the viewer's local time (the stored UTC cron is converted to
		// local for display, and back to UTC on save — exactly like the Schedules view), so the label
		// must show the viewer's local timezone, never "UTC". The DST checkbox only changes whether the
		// wall-clock time is kept fixed across DST transitions, not which zone the field is displayed in.
		el.text(tzAbbrev(getBackupTz()));
	}
	function bkpTzAbbrev(tz) { if (!tz) { return ''; } try { const parts = new Intl.DateTimeFormat('en-US', { timeZone: tz, timeZoneName: 'short' }).formatToParts(new Date()); const p = parts.filter(function (x) { return x.type === 'timeZoneName'; })[0]; return p ? p.value : tz; } catch (e) { return tz; } }


	// ── Reusable model picker ────────────────────────────────────────────
	// Turns any text <input> into a drop-down of a provider's models, with a
	// "Custom" option that reveals the input for manual entry. Shared by every
	// model field so the experience is consistent and there is one implementation.
	function fetchProviderModels(params, force) {
		params = params || {};
		// Client-side cache (per browser session) so a page refresh does not re-hit
		// the provider APIs. Keyed by provider + host + base_url, never the API key.
		// force=true bypasses it (used when the connection details change).
		var ck = 'aimodels:' + (params.provider || '') + '|' + (params.host || '') + '|' + (params.base_url || '');
		if (!force) {
			try {
				var c = JSON.parse(sessionStorage.getItem(ck) || 'null');
				if (c && (Date.now() - c.ts) < 300000) { return $.Deferred().resolve(c.models).promise(); }
			} catch (e) {}
		}
		return $.ajax({ url: './api/ai/models', method: 'POST', contentType: 'application/json',
			data: JSON.stringify($.extend({}, params, { force: !!force })) })
			.then(function(res){
				var models = (res && res.success && Array.isArray(res.data)) ? res.data : [];
				try { sessionStorage.setItem(ck, JSON.stringify({ ts: Date.now(), models: models })); } catch (e) {}
				return models;
			});
	}

	function attachModelPicker(inputId, blankLabel, fetchModels) {
		var $input = $('#' + inputId);
		if (!$input.length) return function(){};
		var $sel = $('#' + inputId + '_select');
		if (!$sel.length) {
			$sel = $('<select>').attr('id', inputId + '_select').addClass('form-field').css({ width: '210px', cursor: 'pointer', display: 'block' });
			$input.before($sel);
		}
		$input.hide();
		if ($sel.children().length === 0) { $sel.append($('<option>').text('Loading models…')); }
		$sel.off('change.mp').on('change.mp', function(){
			var v = $(this).val();
			if (v === '__custom__') { $input.show().focus(); }
			else { $input.val(v).hide(); }
		});
		function populate(models) {
			models = models || [];
			var current = $input.val() || '';
			$sel.empty();
			$sel.append($('<option>').attr('value','').text(blankLabel));
			$sel.append($('<option>').attr('value','__custom__').text('Custom / enter manually…'));
			models.forEach(function(m){ $sel.append($('<option>').attr('value', m).text(m)); });
			if (current === '') { $sel.val(''); $input.hide(); }
			else if (models.indexOf(current) !== -1) { $sel.val(current); $input.hide(); }
			else { $sel.val('__custom__'); $input.show(); }
		}
		function refresh(force) { fetchModels(force).then(populate, function(){ populate([]); }); }
		refresh();
		return function(){ refresh(true); };
	}


	function populateSettings(data) {

		if (!data) return;

		// Order settings
		$('#exchange_buy_slippage').val(data.buySlippage);
		$('#exchange_sell_slippage').val(data.sellSlippage);

		const balCurrencies = Array.isArray(data.balanceCurrencies) ? data.balanceCurrencies : [];
		$('#exchange_balance_currencies').select2({ tags: true, data: balCurrencies });
		$('#exchange_balance_currencies').val(balCurrencies);
		$('#exchange_balance_currencies').trigger('change');

		// Context compression
		$('#ctx_compression_threshold').val(data.ctxCompThreshold);
		$('#ctx_compression_protect_n').val(data.ctxCompProtectN);
		if (data.ctxCompEnabled && !$('#toggleCtxCompression').is(':checked')) $('#toggleCtxCompression').click();

		$('#deal_context_router_model').val(data.dealCtxModel);
		$('#deal_context_router_timeout_ms').val(data.dealCtxTimeout);

		// Model drop-downs for every model field. The provider Model fields list their
		// own provider's models. The Router and Analysis fields follow the Active Provider
		// currently SELECTED in the form (not the running one), so switching the provider
		// dropdown re-lists them without having to save first.
		function currentProviderParams() {
			var p = $('#ai_provider').val();
			if (p === 'ollama') return { provider: 'ollama', host: $('#ollama_host').val(), api_key: $('#ollama_api_key').val() };
			if (p === 'openai') return { provider: 'openai', api_key: $('#openai_api_key').val(), base_url: $('#openai_base_url').val() };
			return { provider: 'none' };
		}
		var ollamaRefresh = attachModelPicker('ollama_model', '(provider default)', function(force){
			return fetchProviderModels({ provider: 'ollama', host: $('#ollama_host').val(), api_key: $('#ollama_api_key').val() }, force);
		});
		var openaiRefresh = attachModelPicker('openai_model', '(provider default)', function(force){
			return fetchProviderModels({ provider: 'openai', api_key: $('#openai_api_key').val(), base_url: $('#openai_base_url').val() }, force);
		});
		var routerRefresh = attachModelPicker('deal_context_router_model', '(default chat model)', function(force){ return fetchProviderModels(currentProviderParams(), force); });
		var analysisRefresh = attachModelPicker('ai_analysis_model', '(default chat model)', function(force){ return fetchProviderModels(currentProviderParams(), force); });
		// Re-list the provider fields when their own connection details change, and the
		// Router/Analysis fields too when the change belongs to the selected provider.
		$('#ollama_host, #ollama_api_key').off('change.mp').on('change.mp', function(){
			ollamaRefresh();
			if ($('#ai_provider').val() === 'ollama') { routerRefresh(); analysisRefresh(); }
		});
		$('#openai_api_key, #openai_base_url').off('change.mp').on('change.mp', function(){
			openaiRefresh();
			if ($('#ai_provider').val() === 'openai') { routerRefresh(); analysisRefresh(); }
		});
		// Switching the Active Provider itself re-lists the Router/Analysis models.
		$('#ai_provider').off('change.mp').on('change.mp', function(){ routerRefresh(); analysisRefresh(); });
		if (data.dealCtxEnabled && !$('#toggleDealContext').is(':checked')) $('#toggleDealContext').click();
		if (data.dealCtxUseRouter && !$('#toggleDealContextRouter').is(':checked')) $('#toggleDealContextRouter').click();

		$('#ai_tools_max_iterations').val(data.toolsMaxIter);
		if (data.toolsEnabled && !$('#toggleAiTools').is(':checked')) $('#toggleAiTools').click();
		if (data.toolsVerify && !$('#toggleAiToolsVerify').is(':checked')) $('#toggleAiToolsVerify').click();
		if (data.toolsExplore && !$('#toggleAiToolsExplore').is(':checked')) $('#toggleAiToolsExplore').click();
		if (data.toolsDeepExplore && !$('#toggleAiToolsDeepExplore').is(':checked')) $('#toggleAiToolsDeepExplore').click();
		if (data.learningEnabled && !$('#toggleAiLearning').is(':checked')) $('#toggleAiLearning').click();
		if (typeof refreshLearningStats === 'function') { refreshLearningStats(); }

		// ── Live tool-calling capability hint for the Ollama chat model ──
		// When AI Tools is on, warn if the chosen model can't call tools (Ollama reports
		// this), so a user on small hardware knows their pick will silently fall back.
		function currentOllamaModel() {
			var $sel = $('#ollama_model_select');
			if ($sel.length) { var sv = $sel.val(); if (sv && sv !== '__custom__' && sv !== '') return sv; }
			return ($('#ollama_model').val() || '').trim();
		}
		var toolsHintTimer = null;
		function updateOllamaToolsHint() {
			var $hint = $('#ollama_tools_hint');
			if (!$hint.length) return;
			var model = currentOllamaModel();
			if ($('#ai_provider').val() !== 'ollama' || !$('#toggleAiTools').is(':checked') || !model) { $hint.hide().empty(); return; }
			$hint.show().css('color', 'var(--color-neutral)').text('Checking tool-calling support…');
			$.ajax({
				url: './api/ai/model-tools-support', method: 'POST', contentType: 'application/json',
				data: JSON.stringify({ provider: 'ollama', host: $('#ollama_host').val(), api_key: $('#ollama_api_key').val(), model: model })
			}).then(function(res){
				if (currentOllamaModel() !== model) return; // selection changed while in flight
				var s = res && res.supported;
				if (s === true) { $hint.css('color', 'var(--color-success)').html('&#10003; This model supports tool-calling.'); }
				else if (s === false) { $hint.css('color', 'var(--color-warning)').html('&#9888; This model may not support tool-calling &mdash; AI Tools will fall back to the Deal Context router. Try llama3.1:8b or qwen2.5:7b/14b.'); }
				else { $hint.css('color', 'var(--color-neutral)').text('Could not verify tool-calling support for this model.'); }
			}, function(){ $hint.css('color', 'var(--color-neutral)').text('Could not verify tool-calling support.'); });
		}
		function scheduleToolsHint() { if (toolsHintTimer) clearTimeout(toolsHintTimer); toolsHintTimer = setTimeout(updateOllamaToolsHint, 400); }
		$('#ollama_model_select').off('change.tc').on('change.tc', scheduleToolsHint);
		$('#ollama_model, #ollama_host').off('change.tc input.tc').on('change.tc input.tc', scheduleToolsHint);
		$('#toggleAiTools, #ai_provider').off('change.tc').on('change.tc', updateOllamaToolsHint);
		updateOllamaToolsHint();

		// ── AI readiness preflight ──
		// One click tells the user whether the AI backend on THEIR machine is reachable and has the
		// chosen model, before they save — so a weak or unconfigured system is caught here, not on the
		// first question. Read-only; reuses the connection fields already on the form.
		function preflightConn() {
			var p = $('#ai_provider').val();
			if (p === 'ollama') { return { provider: 'ollama', host: $('#ollama_host').val(), api_key: $('#ollama_api_key').val(), model: currentOllamaModel(), tools: $('#toggleAiTools').is(':checked') }; }
			if (p === 'openai') { return { provider: 'openai', api_key: $('#openai_api_key').val(), base_url: $('#openai_base_url').val(), model: ($('#openai_model').val() || '').trim(), tools: $('#toggleAiTools').is(':checked') }; }
			return { provider: 'none' };
		}
		function levelColor(l) { return l === 'ok' ? 'var(--color-success)' : (l === 'warn' ? 'var(--color-warning)' : 'var(--color-danger)'); }
		function levelIcon(l) { return l === 'ok' ? '&#10003; ' : (l === 'warn' ? '&#9888; ' : '&#10007; '); }
		$('#ai_preflight_btn').off('click.pf').on('click.pf', function(){
			var $st = $('#ai_preflight_status');
			var conn = preflightConn();
			if (conn.provider === 'none') { $st.css('color', 'var(--color-neutral)').text('Select a provider first.'); return; }
			var $btn = $(this); $btn.prop('disabled', true);
			$st.css('color', 'var(--color-neutral)').text('Checking…');
			$.ajax({ url: './api/ai/preflight', method: 'POST', contentType: 'application/json', data: JSON.stringify(conn) })
				.then(function(res){
					var d = res && res.data;
					var msgs = (d && d.messages) || [];
					if (!msgs.length) { $st.css('color', 'var(--color-neutral)').text('No result.'); return; }
					$st.html(msgs.map(function(m){ return '<div style="color:' + levelColor(m.level) + ';">' + levelIcon(m.level) + $('<span>').text(m.text).html() + '</div>'; }).join(''));
				}, function(){ $st.css('color', 'var(--color-danger)').text('Could not run the check.'); })
				.always(function(){ $btn.prop('disabled', false); });
		});

		// AI Learning: stats readout + export / import of the validated corpus pack.
		window.refreshLearningStats = function() {
			$.getJSON('./api/ai/learning/stats')
				.done(function(r){
					if (!r || r.success === false) { $('#ai_learning_stats').text('—'); return; }
					const by = r.by_source || {};
					const parts = Object.keys(by).filter(k => by[k]).map(k => by[k] + ' ' + k);
					$('#ai_learning_stats').text((r.total || 0) + ' pattern' + ((r.total === 1) ? '' : 's') + (parts.length ? ' (' + parts.join(', ') + ')' : ''));
				})
				.fail(function(){ $('#ai_learning_stats').text('—'); });
		};

		function doLearningExport() {
			$.ajax({ url: './api/ai/learning/export', method: 'GET', dataType: 'text' })
				.done(function(txt){
					const blob = new Blob([txt], { type: 'application/json' });
					const url = URL.createObjectURL(blob);
					const a = document.createElement('a');
					a.href = url; a.download = 'symbot-ai-learning.json';
					document.body.appendChild(a); a.click();
					document.body.removeChild(a); URL.revokeObjectURL(url);
				})
				.fail(function(jqXHR){ alertBox(SymBot.UI.ajaxError(jqXHR, 'Could not export the learning corpus.')); });
		}

		// Confirm before exporting — it's the moment data is about to leave the install, so
		// state plainly what the file does (and doesn't) contain.
		$('#btnLearningExport').off('click.lrn').on('click.lrn', function(){
			$.getJSON('./api/ai/learning/stats').always(function(r){
				const n = (r && r.total) || 0;
				const msg = 'Export <b>' + n + '</b> learned question pattern' + (n === 1 ? '' : 's') + ' to a file?<br><br>'
					+ 'The file contains only <b>questions and the tool names that answered them</b> — never your balances, prices, P/L, or deal IDs (question text is redacted of any numbers or identifiers). It is a plain, readable JSON file you can inspect before sharing.';
				if (window.SymBot && typeof SymBot.UI.confirmDialog === 'function') {
					SymBot.UI.confirmDialog({ content: msg, confirmText: 'Export', cancelText: 'Cancel', onConfirm: doLearningExport });
				} else {
					doLearningExport();
				}
			});
		});

		$('#btnLearningImport').off('click.lrn').on('click.lrn', function(){ $('#learningImportFile').click(); });

		$('#learningImportFile').off('change.lrn').on('change.lrn', function(){
			const file = this.files && this.files[0];
			if (!file) { return; }
			const reader = new FileReader();
			reader.onload = function(e){
				let pack;
				try { pack = JSON.parse(e.target.result); }
				catch (err) { $('#ai_learning_import_msg').css('color', 'var(--color-warning)').text('Not a valid JSON file.'); return; }
				$('#ai_learning_import_msg').css('color', '').text('Verifying…');
				$.ajax({ url: './api/ai/learning/import', method: 'POST', contentType: 'application/json', data: JSON.stringify({ pack: pack }) })
					.done(function(r){
						if (r && r.success) {
							$('#ai_learning_import_msg').css('color', 'var(--color-success)').text('Imported ' + r.imported + (r.rejected ? ' (' + r.rejected + ' rejected)' : ''));
							refreshLearningStats();
						} else {
							$('#ai_learning_import_msg').css('color', 'var(--color-warning)').text((r && r.error) || 'Import failed.');
						}
					})
					.fail(function(jqXHR){ $('#ai_learning_import_msg').css('color', 'var(--color-warning)').text(SymBot.UI.ajaxError(jqXHR, 'Import failed.')); });
			};
			reader.readAsText(file);
			this.value = '';
		});

		// ── Aggregate & verify contributed packs (maintainer tool) ──────────────────────────
		// Escape untrusted text (question strings come from imported packs) before it hits the DOM.
		var lrnEsc = (window.SymBot && SymBot.UI && typeof SymBot.UI.escapeXML === 'function')
			? SymBot.UI.escapeXML
			: function(s){ return String(s == null ? '' : s).replace(/[&<>"']/g, function(c){ return ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' })[c]; }); };
		var lrnPct = function(x){ return (Math.round((x || 0) * 1000) / 10).toFixed(1) + '%'; };
		var aggPacks = [];   // the packs currently under review, so Adopt can re-send them

		function renderAggReport(r){
			var $box = $('#ai_learning_agg_report').show();
			if (!r || r.success === false) { $box.html('<span style="color:var(--color-warning)">' + lrnEsc((r && r.error) || 'Aggregation failed.') + '</span>'); return; }
			var rep = r.report || {}, cmp = r.comparison || null;
			var out = [];
			out.push('<b>' + (rep.contributors || 0) + '</b> contributor' + (rep.contributors === 1 ? '' : 's') + ', <b>' + (rep.unique_questions || 0) + '</b> unique question' + (rep.unique_questions === 1 ? '' : 's') + '.');
			out.push('<b>' + (r.new_count || 0) + '</b> new pattern' + (r.new_count === 1 ? '' : 's') + ' to add'
				+ (rep.already_present ? ', ' + rep.already_present + ' already known' : '')
				+ (rep.dropped_low_support ? ', <b>' + rep.dropped_low_support + '</b> dropped (below ' + rep.min_contributors + ' contributors)' : '')
				+ (rep.rejected_records ? ', ' + rep.rejected_records + ' rejected' : '') + '.');
			if (cmp) {
				var d = cmp.global.delta, col = d > 0 ? 'var(--color-success)' : (d < 0 ? 'var(--color-warning)' : '');
				out.push('Held-out accuracy: ' + lrnPct(cmp.global.before) + ' &rarr; <b>' + lrnPct(cmp.global.after) + '</b> '
					+ '<span style="color:' + col + '">(' + (d >= 0 ? '+' : '') + lrnPct(d) + ', ' + (r.comparison.eval_total || 0) + ' questions)</span>.');
				if (cmp.regressions && cmp.regressions.length) {
					out.push('<span style="color:var(--color-warning)">&#9888; ' + cmp.regressions.length + ' tool regressed: '
						+ cmp.regressions.map(function(x){ return lrnEsc(x.tool) + ' (' + lrnPct(x.before) + '&rarr;' + lrnPct(x.after) + ')'; }).join(', ') + '</span>');
				}
				if (cmp.newly_correct && cmp.newly_correct.length) {
					out.push('<span style="color:var(--color-success)">&#10003; Newly correct:</span> ' + cmp.newly_correct.slice(0, 8).map(function(f){ return lrnEsc(f.question); }).join('; ') + (cmp.newly_correct.length > 8 ? ' &hellip;' : ''));
				}
				if (cmp.newly_wrong && cmp.newly_wrong.length) {
					out.push('<span style="color:var(--color-warning)">&#10007; Newly wrong:</span> ' + cmp.newly_wrong.slice(0, 8).map(function(f){ return lrnEsc(f.question); }).join('; '));
				}
			}
			if (rep.conflicts && rep.conflicts.length) {
				var unresolved = rep.conflicts.filter(function(c){ return c.resolved === false; }).length;
				out.push('<b>' + rep.conflicts.length + '</b> conflict' + (rep.conflicts.length === 1 ? '' : 's') + ' (same question, different tools)'
					+ (unresolved ? ', ' + unresolved + ' unresolved tie' + (unresolved === 1 ? '' : 's') + ' skipped' : ', resolved by majority') + '.');
			}
			var rec = cmp ? cmp.recommend : null;
			if (r.committed) {
				out.push('<span style="color:var(--color-success)"><b>Adopted ' + (r.imported || 0) + ' pattern' + (r.imported === 1 ? '' : 's') + '.</b></span>');
			} else if (r.new_count > 0) {
				out.push('<span style="' + (rec === 'adopt' ? 'color:var(--color-success)' : 'color:var(--color-warning)') + '">Recommendation: <b>' + (rec === 'adopt' ? 'safe to adopt' : 'review before adopting') + '</b></span> '
					+ '<button type="button" id="btnLearningAdopt" class="btnAll" style="margin-left:8px;">Adopt ' + r.new_count + ' pattern' + (r.new_count === 1 ? '' : 's') + '</button>');
			} else {
				out.push('Nothing new to add.');
			}
			$box.html(out.join('<br>'));
		}

		function postAggregate(commit){
			$('#ai_learning_agg_report').show().html('Aggregating &amp; measuring accuracy&hellip;');
			$.ajax({ url: './api/ai/learning/aggregate', method: 'POST', contentType: 'application/json', data: JSON.stringify({ packs: aggPacks, commit: !!commit }) })
				.done(function(r){ renderAggReport(r); if (commit) { refreshLearningStats(); } })
				.fail(function(jqXHR){ $('#ai_learning_agg_report').show().html('<span style="color:var(--color-warning)">' + lrnEsc(SymBot.UI.ajaxError(jqXHR, 'Aggregation failed.')) + '</span>'); });
		}

		$('#ai_learning_agg_report').off('click.lrnadopt').on('click.lrnadopt', '#btnLearningAdopt', function(){ postAggregate(true); });

		$('#btnLearningAggregate').off('click.lrn').on('click.lrn', function(){ $('#learningAggFiles').click(); });

		$('#learningAggFiles').off('change.lrn').on('change.lrn', function(){
			var files = Array.prototype.slice.call(this.files || []);
			this.value = '';
			if (!files.length) { return; }
			var packs = [], pending = files.length, failed = false;
			files.forEach(function(file){
				var reader = new FileReader();
				reader.onload = function(e){
					try { packs.push(JSON.parse(e.target.result)); }
					catch (err) { failed = true; }
					if (--pending === 0) {
						if (failed && !packs.length) { $('#ai_learning_agg_report').show().html('<span style="color:var(--color-warning)">One or more files were not valid JSON.</span>'); return; }
						aggPacks = packs;
						postAggregate(false);
					}
				};
				reader.readAsText(file);
			});
		});

		$('#btnLearningEvaluate').off('click.lrn').on('click.lrn', function(){
			var $box = $('#ai_learning_agg_report').show().html('Measuring current accuracy&hellip;');
			$.getJSON('./api/ai/learning/evaluate')
				.done(function(r){
					if (!r || r.success === false) { $box.html('<span style="color:var(--color-warning)">Could not evaluate.</span>'); return; }
					var out = [ 'On a built-in set of ' + (r.total || 0) + ' practice questions, what the chat has learned points to the right tool <b>' + (r.correct || 0) + '</b> times (<b>' + lrnPct(r.accuracy) + '</b>). Higher is better.' ];
					if (r.misses && r.misses.length) {
						out.push('<span style="opacity:0.85">For these it points to a different tool &mdash; using the chat more, or importing a shared pack, can teach it: ' + r.misses.slice(0, 10).map(function(m){ return lrnEsc(m.question); }).join('; ') + (r.misses.length > 10 ? ' &hellip;' : '') + '</span>');
					}
					$box.html(out.join('<br>'));
				})
				.fail(function(jqXHR){ $box.html('<span style="color:var(--color-warning)">' + lrnEsc(SymBot.UI.ajaxError(jqXHR, 'Could not evaluate.')) + '</span>'); });
		});

		refreshLearningStats();

		// Circuit breaker
		$('#cb_deal_ratio_threshold').val(data.cbDealRatio);
		$('#cb_deal_ratio_window_secs').val(data.cbDealWindow);
		$('#cb_price_drop_percent').val(data.cbPriceDrop);
		$('#cb_price_drop_window_secs').val(data.cbPriceWindow);
		if (data.cbPriceDropEnabled && !$('#togglePriceDrop').is(':checked')) $('#togglePriceDrop').click();
		if (!data.cbPriceDropEnabled && $('#togglePriceDrop').is(':checked')) $('#togglePriceDrop').click();
		$('#cb_pause_duration_secs').val(data.cbPauseDuration);
		$('#cb_repeat_alert_window_secs').val(data.cbRepeatWindow);
		$('#cb_price_zero_alert_count').val(data.cbPriceZeroAlert);
		$('#cb_loss_window_hours').val(data.cbLossWindowHours);
		$('#cb_loss_limit').val(data.cbLossLimit);
		if (data.cbPortfolioLossEnabled && !$('#cb_portfolio_loss_enabled').is(':checked')) $('#cb_portfolio_loss_enabled').click();
		if (!data.cbPortfolioLossEnabled && $('#cb_portfolio_loss_enabled').is(':checked')) $('#cb_portfolio_loss_enabled').click();
		if (data.cbEnabled && !$('#toggleCircuitBreaker').is(':checked')) $('#toggleCircuitBreaker').click();
	}


	function populateBackupSchedule(data) {

		if (!data || !data.cronSchedule) return;

		const [minute, hour, dayOfMonth, , dayOfWeek] = data.cronSchedule.split(' ');
		const tz = data.backupTimezone || '';
		const dst = !!tz;

		if ($('#backup_dst').length) { $('#backup_dst').prop('checked', dst); }
		updateBackupTzLabel();

		$('#backup_days input[type="checkbox"]').prop('checked', false);

		if (dst) {

			// DST-aware: the cron is already local wall time — read it directly, no conversion.
			$('#backup_time').val(`${String(Number(hour)).padStart(2, '0')}:${String(Number(minute)).padStart(2, '0')}`);
			$('#backup_day_month').val((dayOfMonth !== '*' && /^\d+$/.test(dayOfMonth)) ? dayOfMonth : '');
			if (dayOfWeek !== '*') {
				dayOfWeek.split(',').forEach(d => { if (/^\d+$/.test(d)) { $(`#backup_days input[type="checkbox"][value="${Number(d) % 7}"]`).prop('checked', true); } });
			}
		}
		else {

			// UTC cron → the viewer's own local time.
			const uh = Number(hour), um = Number(minute);
			const lt = bkpTimeUtcToLocal(uh, um);

			$('#backup_time').val(`${String(lt.h).padStart(2, '0')}:${String(lt.m).padStart(2, '0')}`);

			if (dayOfMonth !== '*' && /^\d+$/.test(dayOfMonth)) {
				let dom = Number(dayOfMonth) - bkpDayDelta(lt.h, lt.m);
				if (dom < 1) { dom = 31; } else if (dom > 31) { dom = 1; }
				$('#backup_day_month').val(String(dom));
			}
			else {
				$('#backup_day_month').val('');
			}

			if (dayOfWeek !== '*') {
				const localSet = {};
				dayOfWeek.split(',').forEach(d => { if (/^\d+$/.test(d)) { localSet[bkpUtcDowToLocal(Number(d) % 7, uh, um)] = true; } });
				Object.keys(localSet).forEach(d => { $(`#backup_days input[type="checkbox"][value="${d}"]`).prop('checked', true); });
			}
		}

		if (data.maxBackups !== undefined) $('#backup_max').val(data.maxBackups);

		if (data.backupIncludeChats) {
			if (!$('#toggleBackupIncludeChats').is(':checked')) $('#toggleBackupIncludeChats').click();
		}

		// Toggle through the simpleSwitch click handler (like Include AI Chats) so the
		// visual switch and the underlying checkbox stay in sync in both directions.
		const wantSchedules = data.backupIncludeSchedules !== false;
		if ($('#toggleBackupIncludeSchedules').is(':checked') !== wantSchedules) { $('#toggleBackupIncludeSchedules').click(); }

		// Include Configuration defaults OFF (same sync-via-click pattern as the toggles above).
		const wantConfig = data.backupIncludeConfig === true;
		if ($('#toggleBackupIncludeConfig').is(':checked') !== wantConfig) { $('#toggleBackupIncludeConfig').click(); }

		// Backup / SFTP secrets are never sent to the browser (write-only). The fields stay blank and a
		// "is set" indicator is rendered server-side from the *_set flags; leaving a field blank on save
		// preserves the stored value.

		if (data.sftpEnabled !== undefined) {

			if (data.sftpEnabled) {

				$('#toggleSftp').click();
			}

		}

		if (data.enabled !== undefined) {

			if (data.enabled) {

				$('#toggleBackup').click();
			}

		}
	}


	function submitForm() {

		let form = '#formConfig';
		let submitUrl = $(form).attr('action');

		if ($('#password').val() == '') {

			alertBox('Please enter your current password');

			return;
		}

		if ($('#passwordnew').val() != $('#passwordnew2').val()) {

			alertBox('Passwords do not match');

			return;
		}

		let cronData = getBackupScheduleCron();

		if (!cronData.success) {

			return;
		}

		$('#spinner-overlay').fadeIn(100);

		let formData = $(form).serializeArray();

		// Remove existing backup_enabled
		formData = formData.filter(item => item.name !== 'backup_enabled');

		// Private key submit logic:
		// - If the clear flag is set, keep sftp_private_key_clear=1 in the payload
		//   and drop the textarea value so the server removes the stored key.
		// - If the textarea is blank with no clear flag, drop the field entirely
		//   so the server preserves the existing encrypted key.
		// - If the textarea has content, reset the clear flag to 0 so a new key
		//   being pasted doesn't get accidentally cleared by a stale flag.
		if ($('#sftp_private_key_clear').val() === '1') {

			formData = formData.filter(item => item.name !== 'sftp_private_key');
		}
		else if (!$('#sftp_private_key').val().trim()) {

			formData = formData.filter(item => item.name !== 'sftp_private_key');
			formData = formData.filter(item => item.name !== 'sftp_private_key_clear');
		}
		else {

			// New key being submitted — ensure clear flag is 0
			formData = formData.filter(item => item.name !== 'sftp_private_key_clear');
		}

		formData.push({ name: 'cron_backup_schedule', value: cronData.cronSchedule });
		formData.push({ name: 'cron_backup_days', value: cronData.daysOfWeek.join(',') });
		formData.push({ name: 'cron_backup_timezone', value: cronData.timezone || '' });
		formData.push({ name: 'cron_backup_local_time', value: cronData.localTime });
		formData.push({ name: 'cron_backup_utc_time', value: cronData.utcTime });
		formData.push({ name: 'cron_backup_max', value: cronData.maxBackups });
		formData.push({ name: 'cron_backup_password', value: cronData.password });
		formData.push({ name: 'cron_backup_enabled', value: cronData.enabled });
		formData.push({ name: 'cron_backup_include_chats', value: $('#toggleBackupIncludeChats').prop('checked') });
		formData.push({ name: 'cron_backup_include_schedules', value: $('#toggleBackupIncludeSchedules').prop('checked') });
		formData.push({ name: 'cron_backup_include_config', value: $('#toggleBackupIncludeConfig').prop('checked') });

		// Notifications: collect the event × channel matrix into one JSON field (empty string clears the
		// block back to legacy "deliver everywhere"). collectNotifications() is defined in the notifications
		// section script; guard in case the section is absent.
		if (typeof collectNotifications === 'function') {
			formData.push({ name: 'notifications', value: collectNotifications() });
		}

		// Remove any CB fields serialized by serializeArray to avoid duplicates
		// exchange_buy_slippage, exchange_sell_slippage, exchange_balance_currencies
		// are saved via botConfigSave (./api/bot-config), not the main config route

		const ctxFields = ['ctx_compression_enabled','ctx_compression_threshold','ctx_compression_protect_n'];
		formData = formData.filter(item => !ctxFields.includes(item.name));
		formData.push({ name: 'ctx_compression_enabled',   value: String($('#toggleCtxCompression').prop('checked')) });
		formData.push({ name: 'ctx_compression_threshold', value: $('#ctx_compression_threshold').val() });
		formData.push({ name: 'ctx_compression_protect_n', value: $('#ctx_compression_protect_n').val() });

		const dealCtxFields = ['deal_context_enabled','deal_context_use_router','deal_context_router_model','deal_context_router_timeout_ms'];
		formData = formData.filter(item => !dealCtxFields.includes(item.name));
		formData.push({ name: 'deal_context_enabled',           value: String($('#toggleDealContext').prop('checked')) });
		formData.push({ name: 'deal_context_use_router',        value: String($('#toggleDealContextRouter').prop('checked')) });
		formData.push({ name: 'deal_context_router_model',      value: $('#deal_context_router_model').val() });
		formData.push({ name: 'deal_context_router_timeout_ms', value: $('#deal_context_router_timeout_ms').val() });

		const toolFields = ['ai_tools_enabled','ai_tools_max_iterations','ai_tools_verify','ai_tools_explore','ai_tools_deep_explore','ai_learning_enabled'];
		formData = formData.filter(item => !toolFields.includes(item.name));
		formData.push({ name: 'ai_tools_enabled',        value: String($('#toggleAiTools').prop('checked')) });
		formData.push({ name: 'ai_tools_max_iterations', value: $('#ai_tools_max_iterations').val() });
		formData.push({ name: 'ai_tools_verify',         value: String($('#toggleAiToolsVerify').prop('checked')) });
		formData.push({ name: 'ai_tools_explore',        value: String($('#toggleAiToolsExplore').prop('checked')) });
		formData.push({ name: 'ai_tools_deep_explore',   value: String($('#toggleAiToolsDeepExplore').prop('checked')) });
		formData.push({ name: 'ai_learning_enabled',     value: String($('#toggleAiLearning').prop('checked')) });

			const genFields = ['ai_analysis_model','ai_chat_temperature','ai_max_tokens','ai_num_ctx'];
			formData = formData.filter(item => !genFields.includes(item.name));
			formData.push({ name: 'ai_analysis_model',   value: $('#ai_analysis_model').val() });
			formData.push({ name: 'ai_chat_temperature', value: $('#ai_chat_temperature').val() });
			formData.push({ name: 'ai_max_tokens',       value: $('#ai_max_tokens').val() });
			formData.push({ name: 'ai_num_ctx',          value: $('#ai_num_ctx').val() });

		const cbFields = ['cb_enabled','cb_deal_ratio_threshold','cb_deal_ratio_window_secs',
		                  'cb_price_drop_percent','cb_price_drop_window_secs','cb_price_drop_enabled',
		                  'cb_pause_duration_secs','cb_repeat_alert_window_secs','cb_price_zero_alert_count',
		                  'cb_portfolio_loss_enabled','cb_loss_window_hours','cb_loss_limit'];
		formData = formData.filter(item => !cbFields.includes(item.name));

		formData.push({ name: 'cb_enabled',                  value: String($('#toggleCircuitBreaker').prop('checked')) });
		formData.push({ name: 'cb_deal_ratio_threshold',     value: $('#cb_deal_ratio_threshold').val() });
		formData.push({ name: 'cb_deal_ratio_window_secs',   value: $('#cb_deal_ratio_window_secs').val() });
		formData.push({ name: 'cb_price_drop_percent',       value: $('#cb_price_drop_percent').val() });
		formData.push({ name: 'cb_price_drop_window_secs',   value: $('#cb_price_drop_window_secs').val() });
		formData.push({ name: 'cb_price_drop_enabled',        value: String($('#togglePriceDrop').prop('checked')) });
		formData.push({ name: 'cb_pause_duration_secs',      value: $('#cb_pause_duration_secs').val() });
		formData.push({ name: 'cb_repeat_alert_window_secs', value: $('#cb_repeat_alert_window_secs').val() });
		formData.push({ name: 'cb_price_zero_alert_count',   value: $('#cb_price_zero_alert_count').val() });
		formData.push({ name: 'cb_portfolio_loss_enabled',   value: String($('#cb_portfolio_loss_enabled').prop('checked')) });
		formData.push({ name: 'cb_loss_window_hours',        value: $('#cb_loss_window_hours').val() });
		formData.push({ name: 'cb_loss_limit',               value: $('#cb_loss_limit').val() });

		const ipFields = ['ip_server_enabled','ip_server_allow','ip_server_block','ip_login_enabled','ip_login_allow','ip_login_block'];
		formData = formData.filter(item => !ipFields.includes(item.name));
		formData.push({ name: 'ip_server_enabled', value: String($('#toggleIpServer').prop('checked')) });
		formData.push({ name: 'ip_server_allow',   value: $('#ip_server_allow').val() });
		formData.push({ name: 'ip_server_block',   value: $('#ip_server_block').val() });
		formData.push({ name: 'ip_login_enabled',  value: String($('#toggleIpLogin').prop('checked')) });
		formData.push({ name: 'ip_login_allow',    value: $('#ip_login_allow').val() });
		formData.push({ name: 'ip_login_block',    value: $('#ip_login_block').val() });

		$.ajax({
					type: 'POST',
					url: submitUrl,
					data: $.param(formData),
					dataType: 'json',
					success: function(data) {

						$('#spinner-overlay').fadeOut(100);

						if (!data.success) {

							alertBox(data.data, function() { window.location.reload(); });
						}
						else {

							alertBox(data.data, function() { window.location.reload(); });
						}

						$('#password').val('');
					},
					error: function(jqXHR) {

						$('#spinner-overlay').fadeOut(100);

						alertBox(SymBot.UI.ajaxError(jqXHR, 'Could not save the configuration. Please try again.'));
					}
		});
	}


