			<div class="card">

				<b><span class="icon icon-chat"></span> Notifications</b>
				<div style="margin-top: 6px; opacity: 0.8; font-size: var(--fs-body); line-height: 1.5;">
					Choose which events reach each channel. Leave <b>Filter notifications</b> off to deliver everything as before. The Notifications panel always keeps the full history, whatever you choose here. A channel is only reached when its master switch (Telegram / Email SMTP) is also enabled.
				</div>

				<table id="botsCreate" style="margin-top: 8px;" cellpadding=0 cellspacing=0>
					<tr>
						<td>Filter notifications:</td>
						<td><input id="notif_enabled" type="checkbox"></td>
					</tr>
				</table>

				<div id="notif_matrix_wrap" style="display:none; margin-top: 10px;">

					<div class="notif-subgroup-title">Events &rarr; channels
						<span class="toolTip">?<span class="toolTipText">Tick which channels each event is delivered to. An unticked box means that event is never sent to that channel &mdash; the Notifications panel still keeps the full history either way.</span></span>
					</div>
					<table id="notif_matrix" cellpadding=0 cellspacing=0>
						<thead>
							<tr>
								<th>Event</th>
								<th>Browser</th>
								<th>Telegram</th>
								<th>Email</th>
							</tr>
						</thead>
						<tbody id="notif_matrix_body"></tbody>
					</table>

					<div class="notif-subgroup">
						<div class="notif-subgroup-title">Minimum severity per channel
							<span class="toolTip">?<span class="toolTipText">Only notifications at or above this severity reach the channel. Lets one dropdown quiet a whole column (e.g. Email only for critical events).</span></span>
						</div>
						<div class="notif-field-row">
							<span class="notif-field">Browser <select id="notif_sev_browser" class="form-field" style="width:120px;"></select></span>
							<span class="notif-field">Telegram <select id="notif_sev_telegram" class="form-field" style="width:120px;"></select></span>
							<span class="notif-field">Email <select id="notif_sev_email" class="form-field" style="width:120px;"></select></span>
						</div>
					</div>

					<div class="notif-subgroup">
						<div class="notif-subgroup-title">Quiet hours
							<span class="toolTip">?<span class="toolTipText">Suppress notifications during this window. A critical event (a circuit-breaker trip) always gets through.</span></span>
							<input id="notif_qh_enabled" type="checkbox" style="margin-left:10px; vertical-align:middle;">
						</div>
						<div id="notif_qh_row" style="display:none;">
							<div class="notif-field-row">
								<span class="notif-field">From <input id="notif_qh_start" type="time" class="form-field" style="width:120px;"></span>
								<span class="notif-field">To <input id="notif_qh_end" type="time" class="form-field" style="width:120px;"></span>
								<!-- The window follows the viewer's own browser timezone (auto-detected, like Schedules and Database
								     Backups) — shown as a label, stored in a hidden field, evaluated DST-correctly by the server. -->
								<input id="notif_qh_tz" type="hidden">
								<span class="notif-field">
									<!-- Mute only the TEXT, not the whole span: opacity applies to the entire subtree, so putting it
									     on the span would also dim the tooltip popup nested here (its background would render lighter
									     than every other tooltip). -->
									<span style="opacity:0.7;">in your local time (<b id="notif_qh_tzlabel">—</b>)</span>
									<span class="toolTip">?<span class="toolTipText">Quiet hours follow your browser's timezone, shown here. SymBot evaluates the window in this zone and keeps it correct across daylight-saving. Saving from a browser in a different timezone re-anchors it to that zone.</span></span>
								</span>
								<span class="notif-field">Always send <select id="notif_qh_override" class="form-field" style="width:120px;"></select> and above</span>
							</div>
						</div>
					</div>

					<div class="notif-subgroup">
						<div class="notif-subgroup-title">Email recipients
							<span class="toolTip">?<span class="toolTipText">Comma or space separated. Required for the Email channel; delivery uses this instance's SMTP, or the Hub's shared SMTP.</span></span>
						</div>
						<table cellpadding=4>
							<tr><td><input id="notif_email_to" class="form-field" style="width:320px;" placeholder="you@example.com, ops@example.com"></td></tr>
						</table>
					</div>

				</div>

				<script>
				(function(){

					var CATALOG  = <%- JSON.stringify(services['notifications_catalog'] || []).replace(/</g, '\\u003c') %>;
					var CURRENT  = <%- JSON.stringify(services['notifications'] || null) %>;
					var DEFAULTS = <%- JSON.stringify(services['notifications_defaults'] || {}) %>;
					var SEVS = ['debug','info','warning','error','critical'];
					var CH = ['browser','telegram','email'];

					function esc(s){ return SymBot.UI.esc(s); }
					function sevOptions(sel, val){ sel.empty(); SEVS.forEach(function(s){ sel.append('<option value="'+s+'"'+(s===val?' selected':'')+'>'+s.charAt(0).toUpperCase()+s.slice(1)+'</option>'); }); }

					// The effective per-event channel state to seed from: the saved block if present, else the
					// curated defaults (so a fresh form starts sensible). Unknown = default on.
					function seedEvents(){ return (CURRENT && CURRENT.events) ? CURRENT.events : (DEFAULTS.events || {}); }

					function renderMatrix(){
						var ev = seedEvents();
						var body = $('#notif_matrix_body'); body.empty();
						var lastCat = null;
						CATALOG.forEach(function(item){
							if (item.category !== lastCat){
								body.append('<tr class="notif-cat"><td colspan="4">'+esc(item.category)+'</td></tr>');
								lastCat = item.category;
							}
							var cur = ev[item.event] || item.def || {};
							var cells = CH.map(function(ch){
								var on = (cur[ch] !== false);
								return '<td class="notif-ch"><input type="checkbox" class="notif-cell" data-event="'+esc(item.event)+'" data-ch="'+ch+'"'+(on?' checked':'')+'></td>';
							}).join('');
							body.append('<tr class="notif-event-row"><td class="notif-event">'+esc(item.label)+' <span class="notif-ev-sev">('+esc(item.severity)+')</span></td>'+cells+'</tr>');
						});
					}

					function seedControls(){
						var ms = (CURRENT && CURRENT.min_severity) ? CURRENT.min_severity : (DEFAULTS.min_severity || {});
						sevOptions($('#notif_sev_browser'),  ms.browser  || 'info');
						sevOptions($('#notif_sev_telegram'), ms.telegram || 'info');
						sevOptions($('#notif_sev_email'),    ms.email    || 'info');
						var qh = (CURRENT && CURRENT.quiet_hours) ? CURRENT.quiet_hours : (DEFAULTS.quiet_hours || {});
						$('#notif_qh_start').val(qh.start || '22:00');
						$('#notif_qh_end').val(qh.end || '07:00');
						// Timezone is auto-detected from the browser (the shared getTimeZone helper used by
						// Schedules and System Backups), stored in a hidden field, and shown as a label — so
						// the user never types a zone. Saving re-anchors to whatever browser edits it.
						var qtz = 'UTC';
						try { qtz = (typeof getTimeZone === 'function' && getTimeZone().timezone) || (Intl.DateTimeFormat().resolvedOptions().timeZone) || 'UTC'; } catch(e){}
						$('#notif_qh_tz').val(qtz);
						try { $('#notif_qh_tzlabel').text(SymBot.UI.tzAbbrev(qtz)); } catch(e){ $('#notif_qh_tzlabel').text(qtz); }
						sevOptions($('#notif_qh_override'), qh.min_severity_override || 'critical');
						var et = (CURRENT && Array.isArray(CURRENT.email_to)) ? CURRENT.email_to : ((DEFAULTS.email_to)||[]);
						$('#notif_email_to').val(et.join(', '));
					}

					// collectNotifications: called by the config save handler. Off → '' (clears the block back
					// to legacy deliver-everywhere). On → the full JSON block.
					window.collectNotifications = function(){
						if (!$('#notif_enabled').prop('checked')) { return ''; }
						var events = {};
						$('.notif-cell').each(function(){
							var e = $(this).data('event'), ch = $(this).data('ch');
							if (!events[e]) { events[e] = { browser:true, telegram:true, email:true }; }
							events[e][ch] = $(this).prop('checked');
						});
						var emailTo = ($('#notif_email_to').val()||'').split(/[\s,;]+/).map(function(x){return x.trim();}).filter(function(x){return x!=='';});
						return JSON.stringify({
							min_severity: { browser: $('#notif_sev_browser').val(), telegram: $('#notif_sev_telegram').val(), email: $('#notif_sev_email').val() },
							quiet_hours: { enabled: $('#notif_qh_enabled').prop('checked'), start: $('#notif_qh_start').val(), end: $('#notif_qh_end').val(), tz: ($('#notif_qh_tz').val()||'local'), min_severity_override: $('#notif_qh_override').val() },
							email_to: emailTo,
							events: events
						});
					};

					$(function(){
						renderMatrix();
						seedControls();
						var on = !!CURRENT;
						$('#notif_enabled').prop('checked', on);
						$('#notif_matrix_wrap').toggle(on);
						if (CURRENT && CURRENT.quiet_hours && CURRENT.quiet_hours.enabled) { $('#notif_qh_enabled').prop('checked', true); $('#notif_qh_row').show(); }
						try { $('#notif_enabled').simpleSwitch(); $('#notif_qh_enabled').simpleSwitch(); } catch(e){}
						$('#notif_enabled').on('change', function(){ $('#notif_matrix_wrap').toggle($(this).prop('checked')); });
						$('#notif_qh_enabled').on('change', function(){ $('#notif_qh_row').toggle($(this).prop('checked')); });
					});

				})();
				</script>
			</div>

			<div class="card">

				<b><span class="icon icon-ai"></span> Artificial Intelligence (AI)</b>
				<table id="botsCreate" style="margin-top: 5px;" cellpadding=0 cellspacing=0>

