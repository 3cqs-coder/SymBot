						<%- include('partialsSecretClear', { field: 'openai_api_key', isSet: services['ai']['openai']['has_key'] }) %>
					</td>
				</tr>

				<tr>
					<td>
						<label for="openai_model">Model:
							<span class="toolTip">?<span class="toolTipText">
								The model to use, e.g. gpt-4o or gpt-4o-mini
							</span></span>
						</label>
					</td>

					<td>
						<input name="openai_model" id="openai_model" class="form-field" style="width: 250px; margin-top: 6px;" value="<%= services['ai']['openai']['model'] %>">
					</td>
				</tr>

				<tr>
					<td>
						<label for="openai_base_url">Base URL:
							<span class="toolTip">?<span class="toolTipText">
