						<input type="text" id="deal_context_router_model" name="deal_context_router_model" class="form-field" placeholder="(default chat model)" style="width:200px; margin-top:6px;">
					</td>
				</tr>

				<tr>
					<td>
						<label for="deal_context_router_timeout_ms">Router Timeout (ms):
							<span class="toolTip">?<span class="toolTipText">
