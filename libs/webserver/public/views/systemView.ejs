<%- include('./partialsHeaderView'); %>

<script>

function shutDownSystem() {

	SymBot.UI.confirmWithCheckbox({
		content: `Shutdown <%= appData.name_display || appData.name %>?<br><br>
	<B>WARNING:</b>
		<ul>
			<li>This will shutdown <%= appData.name_display || appData.name %>.
			<li>All functionality will stop and will only resume after the system is back up.
			<li>If you do not have a process manager to automatically restart  <%= appData.name_display || appData.name %>, you will need to manually start it again.
		</ul>`,
		confirmLabel: 'Check the box to confirm <span style="color: var(--color-danger);">SHUTDOWN</span> <%= appData.name_display || appData.name %>',
		confirmText: '<div style="color: var(--color-danger);">Shutdown</div>',
		warn: 'You must check the box to confirm shutdown',
		onConfirm: processShutDown
	});
}


function updateSystem() {

	SymBot.UI.confirmWithCheckbox({
		content: `Update <%- appData.name_main %>?<br><br>
	<B>WARNING:</b>
		<ul>
			<li>This will update <%- appData.name_main %> and all Hub instances to the latest version.
			<li>All functionality will stop and will only resume after the system is back online.
			<li><%- appData.name_main %> will shutdown after the update completes. You must start it manually if you do not have a process manager that does it automatically.
			<li>Performing a backup before updating the system is strongly recommended
			<li>It is highly recommended to monitor logs and activity for a period of time after the update completes to ensure everything is working as expected.
		</ul>`,
		confirmLabel: 'Check the box to confirm <span style="color: var(--color-danger);">UPDATE</span> <%- appData.name_main %>',
		confirmText: '<div style="color: var(--color-danger);">Update</div>',
		warn: 'You must check the box to confirm update',
		onConfirm: processUpdate
	});
}


function backupDb() {

$.confirm({
	  title: false,
	  boxWidth: "50%",
	  useBootstrap: false,
	  content: `<div style="font-size: var(--fs-dialog-title); text-align: left;">Backup <%= appData.name_display || appData.name %> Database?<br><br>
	<form autocomplete="off" action="" style="display: inline;">
		<B>WARNING:</b>

		<ul>
			<li>This will create a realtime backup of the <%= appData.name_display || appData.name %> database.
			<li>This could cause delays in other functionality while processing and data may change during the backup process.
			<li>Write your password down in a safe place. You will not be able to restore the database without it.
		</ul>

		<label for="file-input"><b>Choose file encryption password:</b></label>
		<input class="form-field" type="password" style="width: 200px;" id="encryptPassword" name="encryptPassword" required>

		<label for="file-input"><b>Confirm encryption password:</b></label>
		<input class="form-field" type="password" style="width: 200px;" id="encryptPasswordConfirm" name="encryptPasswordConfirm" required>

		<br><br>
		<input type="checkbox" id="includeChatsBackup" class="form-field" style="width: 20px;" /> <b>Include AI chats</b>
		<br>
		<input type="checkbox" id="includeSchedulesBackup" class="form-field" style="width: 20px;" /> <b>Include schedules</b> <span style="color: #888;">(includes stored backup/SFTP credentials)</span>
		<br>
		<input type="checkbox" id="includeConfigBackup" class="form-field" style="width: 20px;" /> <b>Include configuration</b> <span style="color: #888;">(app settings + exchange keys; makes the backup portable but it then carries your keys &mdash; keep it safe, and it only opens on a server using the same app password)</span>

		<br><br>

		<input type="checkbox" id="confirmBox" class="form-field" style="width: 20px;" /> <b>Check the box to confirm <span style="color: var(--color-danger);">BACKUP</span> database</b>
	</form>
	</div>`,
	  buttons: {
		  formSubmit: {
			  btnClass: 'btn-default',
			  text: '<div style="color: var(--color-danger);">Backup</div>',
			  action: function() {

				const inputValue = parseFloat($('#confirmNum').val());
				const confirmBox = $('#confirmBox').prop('checked');
				const password = $('#encryptPassword').val();
				const passwordConfirm = $('#encryptPasswordConfirm').val();

				if (!confirmBox) {

					alertBox('You must check the box to confirm backup', function() {});
				}
				else if (password == undefined || password == null || password == '') {

					alertBox('You must enter a password to encrypt the file with', function() {});
				}
				else if (password !== passwordConfirm) {

					alertBox('Passwords do not match', function() {});
				}
				else {

					const includeChats = $('#includeChatsBackup').prop('checked');
					const includeSchedules = $('#includeSchedulesBackup').prop('checked');
					const includeConfig = $('#includeConfigBackup').prop('checked');
					processBackupDb(password, includeChats, includeSchedules, includeConfig);
				 }
			  },
		  },
		  cancel: {
			  btnClass: 'btn-default',
			  text: '<div style="color: #000000;">Cancel</div>',
			  action: function() {},
		},
	},
	  onContentReady: function() {

		$('#confirmBox').prop('checked', false);
		$('#includeChatsBackup').simpleSwitch();
		$('#includeChatsBackup').prop('checked', false);
		$('#includeSchedulesBackup').simpleSwitch();
		$('#includeSchedulesBackup').prop('checked', true);
		$('#includeConfigBackup').simpleSwitch();
		$('#includeConfigBackup').prop('checked', false);

		let jc = this;
		  this.$content.find("form").on("submit", function(e) {
			e.preventDefault();
			  jc.$$formSubmit.trigger("click");
		  });
	  },
  });
}


function restoreDb() {

$.confirm({
	  title: false,
	  boxWidth: "50%",
	  useBootstrap: false,
	  content: `<div style="font-size: var(--fs-dialog-title); text-align: left;">Restore <%= appData.name_display || appData.name %> Database?<br><br>
	<form action="" style="display: inline;">
		<B>WARNING:</b> 
		
		<ul>
			<li>This will delete all existing data in the <%= appData.name_display || appData.name %> database.
			<li>All bots and functionality will resume at the same point the backup was created.
			<li>Be aware of any assets or orders on your exchange that may have already been previously bought, sold, etc.
			<li>If you are restoring the database to a different server or instance from where the backup was created, you may need to reset the server ID.
			<li><%= appData.name_display || appData.name %> will shutdown after the restore completes. You must start it manually if you do not have a process manager that does it automatically.
		</ul>
	
	<form id="restore-form" autocomplete="off" onsubmit="event.preventDefault();">
		<label for="file-input"><b>Select backup file:</b></label>
		<input class="form-field" type="file" style="width: 100%; cursor: pointer; border: 0;" id="file-input" name="backupFile" accept=".zip,.enc" required>

		<label for="file-input"><b>File decryption password:</b></label>
		<input class="form-field" type="password" style="width: 200px;" id="decryptPassword" name="decryptPassword" required>

		<br><br>
		<input id="resetServerId" name="resetServerId" type=checkbox class="form-field"> &nbsp; <b>Reset server ID</b>
		<br><br>
		<input id="resetAiChats" name="resetAiChats" type=checkbox class="form-field"> &nbsp; <b>Reset AI chat history</b>
		<br>
		<input id="convertData" name="convertData" type=checkbox class="form-field"> &nbsp; <b>Convert all bots and deals to sandbox mode</b>
		<br>
		<input id="restoreSchedules" name="restoreSchedules" type=checkbox class="form-field"> &nbsp; <b>Restore schedules</b> <span style="color: #888;">(overwrites this instance's schedules &amp; backup settings)</span>
		<br>
		<input id="restoreConfig" name="restoreConfig" type=checkbox class="form-field"> &nbsp; <b>Restore configuration</b> <span style="color: #888;">(only if the backup includes it; overwrites this server's settings, exchange keys &amp; app password with the backup's &mdash; sign in afterward with the source server's app password)</span>
	</form>

	<br><br>
	<input type="checkbox" id="confirmBox" class="form-field" style="width: 20px;" /> <b>Check the box to confirm <span style="color: var(--color-danger);">RESTORE</span> database</b>
	</form>
	</div>`,
	  buttons: {
		  formSubmit: {
			  btnClass: 'btn-default',
			  text: '<div style="color: var(--color-danger);">Restore</div>',
			  action: function() {

				const inputValue = parseFloat($('#confirmNum').val());
				const confirmBox = $('#confirmBox').prop('checked');
				const convertData = $('#convertData').prop('checked');
				const resetServerId = $('#resetServerId').prop('checked');
				const resetAiChats  = $('#resetAiChats').prop('checked');
				const password = $('#decryptPassword').val();

				if (!confirmBox) {

					alertBox('You must check the box to confirm restore', function() {});
				}
				else if (password == undefined || password == null || password == '') {

					alertBox('You must enter the file password', function() {});
				}
				else {

					const includeSchedules = $('#restoreSchedules').prop('checked');
					const restoreConfig = $('#restoreConfig').prop('checked');
					processRestoreDb(password, convertData, resetServerId, resetAiChats, includeSchedules, restoreConfig);
				 }
			  },
		  },
		  cancel: {
			  btnClass: 'btn-default',
			  text: '<div style="color: #000000;">Cancel</div>',
			  action: function() {},
		},
	},
	onOpenBefore: function () {
 
 		$('#convertData').simpleSwitch();
		$('#convertData').prop('checked', false);

		$('#resetServerId').simpleSwitch();
		$('#resetServerId').prop('checked', false);
		$('#resetAiChats').simpleSwitch();
		$('#resetAiChats').prop('checked', false);

		$('#restoreSchedules').simpleSwitch();
		$('#restoreSchedules').prop('checked', false);

		$('#restoreConfig').simpleSwitch();
		$('#restoreConfig').prop('checked', false);
	},
	onContentReady: function() {

		$('#confirmBox').prop('checked', false);

		let jc = this;
		  this.$content.find("form").on("submit", function(e) {
			e.preventDefault();
			  jc.$$formSubmit.trigger("click");
		  });
	},
  });
}


function loadRollbacks() {

	$.ajax({
		type: 'GET',
		url: './system/rollbacks',
		dataType: 'json',
		success: function(data) {

			const $list = $('#rollback-list');
			$list.empty();

			if (!data.data || data.data.length === 0) {

				$list.append('<div style="font-size: 1.1rem; color: #888;">No rollback snapshots available. Snapshots are created automatically before each update.</div>');
				return;
			}

			data.data.forEach(function(snap) {

				const date = snap.date ? dateConvertLocal(snap.date) : 'Unknown date';
				$list.append(
					'<div style="display: flex; align-items: center; gap: 12px; padding: 6px 0; border-bottom: 1px solid var(--table-border-color);">' +
					'<span style="font-size: 1.1rem; flex: 1;">v' + snap.version + ' &mdash; ' + date + '</span>' +
					'<a href="javascript:void(0);" onclick="rollbackSystem(' + JSON.stringify(snap.snapshotName) + ');" style="color: var(--color-danger); font-size: var(--fs-body);">Rollback</a>' +
					'</div>'
				);
			});
		},
		error: function() {

			$('#rollback-list').html('<div style="color: var(--color-danger);">Failed to load rollback snapshots.</div>');
		}
	});
}


function rollbackSystem(snapshotName) {

	// Shared checkbox-confirm scaffold (SymBot.UI.confirmWithCheckbox).
	SymBot.UI.confirmWithCheckbox({
		content: 'Rollback to ' + snapshotName + '?<br><br>' +
			'<div style="font-size: var(--fs-body); padding: 8px; background: rgba(255,140,0,0.15); border-left: 3px solid #ffa000; border-radius: 2px;">' +
			'<b>Note:</b> Rollback restores code files only. The database is not affected. ' +
			'If the update introduced database schema changes, rolling back the code may cause compatibility issues. ' +
			'Review the logs after restart to confirm everything is working.</div>',
		confirmLabel: 'Check the box to confirm <span style="color: var(--color-danger);">ROLLBACK</span>',
		confirmText: '<div style="color: var(--color-danger);">Rollback</div>',
		warn: 'You must check the box to confirm rollback',
		onConfirm: function() { processRollback(snapshotName); }
	});
}


function processRollback(snapshotName) {

	$('#spinner-overlay').fadeIn(100);

	$.ajax({
		type: 'POST',
		url: './system/rollback',
		contentType: 'application/json',
		data: JSON.stringify({ snapshotName }),
		dataType: 'json',
		success: function(data) {

			$('#spinner-overlay').fadeOut(100);

			if (data.success) {

				alertBox('Rollback successful! SymBot is shutting down. If you do not have a process manager it must be started manually.', function() {});
			}
			else {

				alertBox('Rollback failed: ' + (data.error || 'Unknown error'), function() {});
			}
		},
		error: function(data) {

			$('#spinner-overlay').fadeOut(100);
			alertBox('Error occurred during rollback.', function() {});
		}
	});
}


function showRollbacks() {

	$.confirm({
		title: false,
		boxWidth: '60%',
		useBootstrap: false,
		content: '<div style="font-size: var(--fs-dialog-title); text-align: left;">Rollback System<br><br>' +
			'<div id="rollback-list" style="font-size: 1.1rem; min-height: 40px;">Loading...</div>' +
			'</div>',
		buttons: {
			close: {
				btnClass: 'btn-default',
				text: '<div style="color: #000000;">Close</div>',
				action: function() {}
			}
		},
		onContentReady: function() {

			loadRollbacks();
		}
	});
}


function processShutDown() {

    const requestBody = {};

    $('#spinner-overlay').fadeIn(100);

    $.ajax({
        type: 'POST',
        url: './system/shutdown',
        data: requestBody,
        dataType: 'json',
        success: function(data) {
            $('#spinner-overlay').fadeOut(100);

			window.location.reload();
        },
        error: function(data) {
            $('#spinner-overlay').fadeOut(100);

            window.location.reload();
        },
    });
}


function processUpdate() {

const requestBody = {};

$('#spinner-overlay').fadeIn(100);

$.ajax({
		type: 'POST',
		url: './system/update',
		data: requestBody,
        dataType: 'json',
		success: function(data) {

			$('#spinner-overlay').fadeOut(100);

			alertBox('Update successful!', function() {});
		},
		error: function(data) {

			$('#spinner-overlay').fadeOut(100);

			let message = 'Error occurred during update process.';

			const responseText = data.responseText || message;

			try {

				const parsedResponse = JSON.parse(responseText);
				message = parsedResponse.message || responseText;
			}
			catch (e) {

				message = responseText;
			}

			alertBox(message, function() {});
		}
	});
}


function processBackupDb(password, includeChats, includeSchedules, includeConfig) {

	const requestBody = new URLSearchParams();
	requestBody.append('password', password);
	requestBody.append('include_chats', includeChats ? 'true' : 'false');
	requestBody.append('include_schedules', includeSchedules ? 'true' : 'false');
	requestBody.append('include_config', includeConfig ? 'true' : 'false');

	$('#spinner-overlay').fadeIn(100);

	fetch('./system/backup', {
			method: 'POST',
			body: requestBody,
			headers: {
				'Content-Type': 'application/x-www-form-urlencoded',
			}
		})
		.then(response => {

			if (response.ok) {

				// Extract filename from Content-Disposition header
				const disposition = response.headers.get('Content-Disposition');
				let filename = 'backup-file'; // Default filename

				if (disposition && disposition.includes('attachment')) {

					const matches = /filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/.exec(disposition);

					if (matches != null && matches[1]) {
						filename = matches[1].replace(/['"]/g, '');
					}
				}

				return response.blob().then(blob => {

					// Create a link element, set the download attribute, and trigger the download
					const link = document.createElement('a');
					const url = URL.createObjectURL(blob);
					link.href = url;
					link.download = filename; // Use the extracted filename
					document.body.appendChild(link);
					link.click();
					URL.revokeObjectURL(url);
					document.body.removeChild(link);
					$('#spinner-overlay').fadeOut(100);
					alertBox('System backup ' + filename + ' successful! Your download should start automatically.', function() {});
				});
			}
			else {

				return response.text().then(text => {
					throw new Error(text);
				});
			}
		})
		.catch(error => {

			$('#spinner-overlay').fadeOut(100);

			alertBox(error.message || 'Error occurred while trying to create the system backup.', function() {});
		});
}


function processRestoreDb(password, convertData, resetServerId, resetAiChats, includeSchedules, restoreConfig) {

	const fileInput = $('#file-input')[0]; // Assuming you have an input with id="file-input"
	const file = fileInput.files[0];

	if (!file) {

		alertBox('Please select a file to upload.');
		return;
	}

	const formData = new FormData();

	formData.append('backupFile', file);
	formData.append('convertData', convertData);
	formData.append('resetServerId', resetServerId);
	formData.append('resetAiChats', resetAiChats || false);
	formData.append('includeSchedules', includeSchedules !== false);
	formData.append('restoreConfig', restoreConfig === true);
	formData.append('password', password);

	$('#spinner-overlay').fadeIn(100);

	$.ajax({
		type: 'POST',
		url: './system/restore',
		data: formData,
		contentType: false, // Prevent jQuery from overriding content type
		processData: false, // Prevent jQuery from processing the data
		success: function(data) {

			$('#spinner-overlay').fadeOut(100);

			alertBox('Database restore successful!', function() {});
		},
		error: function(data) {

			$('#spinner-overlay').fadeOut(100);

			let message = 'Error occurred during the restore process.';

			const responseText = data.responseText || message;

			try {

				const parsedResponse = JSON.parse(responseText);
				message = parsedResponse.message || responseText;
			}
			catch (e) {

				message = responseText;
			}

			alertBox(message, function() {});
		}
	});
}


function renderSystemHealth(d) {

	const mem = d.memory || {};

	// Primary memory figure is already the correct one for this context
	// (RSS standalone, Attributed when running as a Hub worker).
	$('#memLabel').text('Memory (' + (mem.primary_label || 'RSS') + ')');
	$('#memValue').text(mem.primary_mb != null ? mem.primary_mb.toLocaleString() + ' MB' : '—');

	// Sub-line: show the heap breakdown; when RSS is process-shared (Hub worker),
	// say so explicitly so the shared number is never mistaken for this instance's.
	let memSub = 'Heap ' + (mem.heap_used_mb != null ? mem.heap_used_mb.toLocaleString() : '—') +
				 ' / ' + (mem.heap_total_mb != null ? mem.heap_total_mb.toLocaleString() : '—') + ' MB';

	if (mem.rss_is_shared) {

		memSub += ' · process RSS ' + (mem.rss_mb != null ? mem.rss_mb.toLocaleString() : '—') + ' MB (shared by all instances)';
	}

	$('#memSub').text(memSub);

	$('#uptimeValue').text(d.started ? timeDiff(new Date(d.started), new Date()) : '—');
	$('#activeDealsValue').text(d.active_deals != null ? d.active_deals : '—');

	// Load: show the 1-minute run-queue average as a "% of cores" figure, which is
	// readable at a glance (raw load means nothing without the core count). The
	// full 1m / 5m / 15m triple and core count go on the sub-line. Color-coded to
	// match the Risk % convention elsewhere: green < 70%, amber 70–89%, red 90%+.
	const load = d.load_avg;
	const cores = d.cpu_count;

	if (Array.isArray(load) && load.length >= 1 && cores > 0) {

		const load1 = load[0];
		const loadPct = Math.min(999, Math.round((load1 / cores) * 100));

		$('#loadValue').text(loadPct + '%');

		// Reuse the profit/risk color classes already in the stylesheet.
		const loadClass = loadPct >= 90 ? 'health-load-high' : (loadPct >= 70 ? 'health-load-med' : 'health-load-low');
		$('#loadValue').removeClass('health-load-low health-load-med health-load-high').addClass(loadClass);

		$('#loadSub').text(load.map(l => l.toFixed(2)).join(' / ') + ' · ' + cores + (cores === 1 ? ' core' : ' cores'));
	}
	else {

		// Platforms that don't report load (e.g. Windows) return zeros/empty.
		$('#loadValue').text('—').removeClass('health-load-low health-load-med health-load-high');
		$('#loadSub').text(cores > 0 ? (cores + (cores === 1 ? ' core' : ' cores')) : '');
	}

	// Foot: host memory context + app version + PID.
	let foot = '';

	if (d.host_available_mem_mb != null && d.host_total_mem_mb != null) {

		// Host memory is at GB scale, so show GB for readability (e.g. "1.01 GB available of 3.78 GB").
		// The figure is AVAILABLE memory — accurate on Linux (MemAvailable) and Windows; on an OS that
		// only reports free pages (macOS) it is labeled "free" so the number is never overstated as
		// availability. The process-memory tile stays in MB, where the smaller figures read better.
		const availGb = (d.host_available_mem_mb / 1024).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
		const totalGb = (d.host_total_mem_mb    / 1024).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
		const memWord = (d.host_mem_basis === 'available') ? 'available' : 'free';

		foot = 'Host memory: ' + availGb + ' GB ' + memWord + ' of ' + totalGb + ' GB';
	}

	if (d.app_version) { foot += (foot ? ' · ' : '') + 'SymBot v' + d.app_version; }

	if (d.pid != null) { foot += (foot ? ' · ' : '') + 'PID ' + d.pid; }

	$('#systemHealthFoot').text(foot);

	$('#systemHealthStatus').text('Healthy').addClass('ok');
}


function loadSystemHealth() {

	$.ajax({
				type: 'GET',
				url: './api/system/health',
				dataType: 'json',
				success: function(res) {

					if (res && res.data) {

						renderSystemHealth(res.data);
					}
				},
				error: function() {

					$('#systemHealthStatus').text('Unavailable').removeClass('ok');
				}
	});
}


$(document).ready(function() {

	loadSystemHealth();

	// Refresh on the same cadence the Hub cards use.
	setInterval(loadSystemHealth, 30000);
});


</script>

<main>

	<div id="contentBox">

	<div class="contentHeaderBox">
		<b class="contentHeader">System Tools</b>
	</div>

	<div id="systemHealthCard" class="system-health-card">
		<div class="system-health-head">
			<span class="system-health-title">System Health</span>
			<span id="systemHealthStatus" class="system-health-status">Loading…</span>
		</div>
		<div class="system-health-grid">
			<div class="system-health-stat">
				<span class="system-health-stat-label" id="memLabel">Memory</span>
				<span class="system-health-stat-value" id="memValue">—</span>
				<span class="system-health-stat-sub" id="memSub"></span>
			</div>
			<div class="system-health-stat">
				<span class="system-health-stat-label">Load</span>
				<span class="system-health-stat-value" id="loadValue">—</span>
				<span class="system-health-stat-sub" id="loadSub"></span>
			</div>
			<div class="system-health-stat">
				<span class="system-health-stat-label">Uptime</span>
				<span class="system-health-stat-value" id="uptimeValue">—</span>
			</div>
			<div class="system-health-stat">
				<span class="system-health-stat-label">Active Deals</span>
				<span class="system-health-stat-value" id="activeDealsValue">—</span>
			</div>
		</div>
		<div class="system-health-foot" id="systemHealthFoot"></div>
	</div>

	<div class="view-body">

		<div class="mainMenuItem">
			<a href="javascript:void(0);" onclick="backupDb();"><span class="menu-icon">&#9741;</span> Create System Backup</a>
		</div>

		<div class="mainMenuItem">
