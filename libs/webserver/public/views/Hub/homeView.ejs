<%- include('../partialsHeaderView'); %>

<script>

	let dashboardTimeout;

	const getCurrencySymbol = <%- getCurrencySymbol %>;


	function setDashboardTimeout() {

		clearTimeout(dashboardTimeout);
		dashboardTimeout = setTimeout(loadDashboard, 30000);
	}


	function loadDashboard() {

		$.ajax({
			type: 'GET',
			url: './api/hub/dashboard',
			dataType: 'json',
			success: function(data) {

				if (!data.success) { setDashboardTimeout(); return; }

				renderDashboard(data.instances || [], data.totals || {});
				setDashboardTimeout();
			},
			error: function(err) {

				if (err.status === 401) { window.location.href = './login'; return; }
				setDashboardTimeout();
			}
		});
	}


	// Escape operator-entered text (the instance display name) before it goes into innerHTML.
	function escHtml(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function(c){ return { '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;' }[c]; }); }

	function renderDashboard(instances, totals) {

		const sym = '$';

		// Render a profit value that may be a single-currency scalar (with its own symbol) or, when deals span
		// multiple quote currencies, a per-currency breakdown — the server never sums across currencies, so the
		// dashboard never shows a meaningless mixed total. Returns { text, cls }.
		function fmtProfit(obj) {
			if (obj && typeof obj.profit === 'number') {
				const s = getCurrencySymbol(obj.profit_currency) || sym;
				return { text: s + obj.profit.toFixed(2), cls: obj.profit >= 0 ? 'profit-positive' : 'profit-negative' };
			}
			const by = (obj && obj.profit_by_currency) || {};
			const keys = Object.keys(by);
			if (!keys.length) { return { text: sym + '0.00', cls: 'profit-positive' }; }
			const parts = keys.map(function (c) { return (by[c] >= 0 ? '+' : '') + by[c].toFixed(2) + ' ' + c; });
			return { text: parts.join('  ·  '), cls: '' };
		}

		// ── Combined totals bar ────────────────────────────────────────────
		const tp = fmtProfit(totals);

		$('#hub-total-deals').text(totals.deals || 0);
		$('#hub-total-bots').text(totals.bots || 0);
		$('#hub-total-profit')
			.removeClass('profit-positive profit-negative')
			.addClass(tp.cls)
			.text(tp.text);

		// ── Per-instance cards ─────────────────────────────────────────────
		const container = $('#hub-instance-cards');
		container.empty();

		for (const inst of instances) {

			const ip = fmtProfit(inst);
			const portfolio = inst.portfolio;
			let portfolioRows = '';

			if (portfolio) {

				const riskPct = portfolio.risk_percent;
				const riskClass = riskPct >= 90 ? 'portfolio-risk-high'
				                : riskPct >= 70 ? 'portfolio-risk-mid'
				                : 'portfolio-risk-low';

				const quoteArr = Object.keys(portfolio.balances || {});
				const quote    = quoteArr[0] || 'USD';
				const quoteSym = getCurrencySymbol(quote) || sym;

				const portfolioVal = portfolio.is_sandbox
					? '<span style="opacity:0.5;">Sandbox</span>'
					: quoteSym + (portfolio.portfolio_total || 0).toFixed(2);

				const balanceAge = portfolio.is_sandbox ? '' :
					portfolio.balance_updated
						? '<div class="hub-dash-card-row" style="margin-top:4px;">' +
							'<span class="hub-dash-label">Balance</span>' +
							'<span style="font-size:var(--fs-body); opacity:0.5;">' + timeAgo(portfolio.balance_updated) + '</span>' +
						  '</div>'
						: '';

				portfolioRows =
					'<div class="hub-dash-divider"></div>' +
					'<div class="hub-dash-card-row">' +
						'<span class="hub-dash-label">Portfolio</span>' +
						'<span>' + portfolioVal + '</span>' +
					'</div>' +
					'<div class="hub-dash-card-row">' +
						'<span class="hub-dash-label">Max Funds</span>' +
						'<span>' + quoteSym + (portfolio.total_max_funds || 0).toFixed(2) + '</span>' +
					'</div>' +
					'<div class="hub-dash-card-row">' +
						'<span class="hub-dash-label">Risk</span>' +
						'<span class="' + riskClass + '">' + (riskPct !== null ? riskPct + '%' : 'N/A') + '</span>' +
					'</div>' +
					balanceAge;
			}

			const isSandbox  = portfolio && portfolio.is_sandbox;
			const sandboxBadge = isSandbox ? ' <span class="hub-dash-sandbox-badge">SANDBOX</span>' : '';
			const isOnline = !!portfolio;
			const statusDot = '<span class="hub-dash-status ' + (isOnline ? 'is-online' : 'is-offline') + '"></span>';

			container.append(
				'<div class="hub-dash-card' + (isOnline ? '' : ' is-offline') + '">' +
					'<div class="hub-dash-card-title" role="heading" aria-level="3">' + statusDot + escHtml(inst.name_display || inst.name) + sandboxBadge + '</div>' +
					'<div class="hub-dash-card-row">' +
						'<span class="hub-dash-label">Active Deals</span>' +
						'<span style="font-weight: var(--fw-medium);">' + inst.deals + '</span>' +
					'</div>' +
					'<div class="hub-dash-card-row">' +
						'<span class="hub-dash-label">Bots</span>' +
						'<span>' + inst.bots + '</span>' +
					'</div>' +
					'<div class="hub-dash-card-row">' +
						'<span class="hub-dash-label">Active P/L</span>' +
						'<span class="' + ip.cls + '" style="font-weight: var(--fw-medium);">' + escHtml(ip.text) + '</span>' +
					'</div>' +
					portfolioRows +
					'<div class="hub-dash-card-actions">' +
						'<a href="./deals?instance=' + encodeURIComponent(inst.name) + '" class="hub-dash-card-link">Deals</a>' +
						'<a href="./bots?instance='  + encodeURIComponent(inst.instanceId) + '" class="hub-dash-card-link">Bots</a>' +
					'</div>' +
				'</div>'
			);
		}
	}


	function timeAgo(dateStr) {

		const diffSec = Math.floor((Date.now() - new Date(dateStr).getTime()) / 1000);
		if (diffSec < 60)  return diffSec + 's ago';
		if (diffSec < 3600) return Math.floor(diffSec / 60) + 'm ago';
		return Math.floor(diffSec / 3600) + 'h ago';
	}


	$(document).ready(function() {

		loadDashboard();
	});

</script>


<main>

	<div id="contentBox">

		<!-- Combined totals box -->
		<div style="text-align: center; margin-bottom: 24px; padding-top: 24px;">
			<div class="hub-dash-totals-box">
				<!-- Polite, atomic live region: the compact fleet totals are announced when they change on the
				     30s poll, without announcing the per-instance card re-render. -->
				<div class="summary-bar" aria-live="polite" aria-atomic="true" style="justify-content: center; gap: 28px; margin-top: 0;">
					<p>Deals: <span id="hub-total-deals">—</span></p>
					<p>Bots: <span id="hub-total-bots">—</span></p>
					<p>Active P/L: <span id="hub-total-profit">—</span></p>
				</div>
			</div>
		</div>

		<!-- Per-instance cards -->
		<div class="hub-home-col" style="margin-bottom: 20px;">
			<div id="hub-instance-cards" class="hub-dash-grid"></div>
		</div>

		<!-- Nav -->
		<div class="hub-home-col">

			<div class="card">

				<div class="section-title"><span class="icon icon-list"></span> Hub</div>

				<div class="mainMenuItem">
					<a href="./deals"><span class="menu-icon">&#9654;</span> Active Deals</a>
				</div>

				<div class="mainMenuItem">
					<a href="./bots"><span class="menu-icon">&#9632;</span> Bots</a>
				</div>

				<div class="mainMenuItem" style="border-bottom: 0;">
					<a href="./manage"><span class="menu-icon">&#9776;</span> Manage Instances</a>
				</div>

			</div>

			<div class="card">

				<div class="section-title"><span class="icon icon-settings"></span> Tools &amp; Settings</div>

				<div class="mainMenuItem">
					<a href="https://www.symrank.com" target=_blank><span class="menu-icon">&#8599;</span> Crypto Screener</a>
				</div>

				<div class="mainMenuItem">
					<a href="./news"><span class="menu-icon">&#9632;</span> News</a>
				</div>

				<div class="mainMenuItem">
					<a href="./config"><span class="menu-icon">&#9881;</span> Configuration</a>
				</div>

				<div class="mainMenuItem">
					<a href="./backups"><span class="menu-icon">&#9741;</span> Backups</a>
				</div>

				<div class="mainMenuItem" style="border-bottom: 0;">
					<a href="./logs"><span class="menu-icon">&#9783;</span> Logs</a>
				</div>

			</div>

			<div class="card">

				<div class="section-title"><span class="icon icon-key"></span> Account</div>

				<div class="mainMenuItem" style="border-bottom: 0;">
					<a href="./logout"><span class="menu-icon">&#8594;</span> Log Out</a>
				</div>

			</div>

		</div>

	</div>

</main>


<%- include('../partialsFooterView'); %>
