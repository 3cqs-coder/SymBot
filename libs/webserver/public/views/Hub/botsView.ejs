<%- include('../partialsHeaderView'); %>

<script>

	let activeInstances = [];
	let confirmWaiting = false;

	// Shared auto-refresh timer (SymBot.UI owns the timeout internally). The thin local
	// setReloadTimeout / initRefreshSelector wrappers below keep every existing callsite unchanged.
	const _autoRefresh = SymBot.UI.autoRefresh({
		storageKey: 'hubBotsRefreshMs',
		intervals: [ { label: '15s', ms: 15000 }, { label: '30s', ms: 30000 }, { label: '60s', ms: 60000 }, { label: 'Paused', ms: 0 } ],
		defaultMs: 30000,
		selector: '#hubRefreshInterval',
		onReload: function() { getActiveBots(); }
	});


	// ── Refresh management (delegates to SymBot.UI.autoRefresh; see _autoRefresh above) ──
	function setReloadTimeout() { _autoRefresh.schedule(); }
	function initRefreshSelector() { _autoRefresh.initSelector(); }


	// ── Bot actions ───────────────────────────────────────────────────────────

	// Delegates to SymBot.UI.postAction (spinner + POST + 401→login + alertBox). On success reloads the
	// bot list; on failure just resumes the auto-refresh timer.
	function botAction(instanceId, action, botId, data, successMsg) {
		SymBot.UI.postAction({
			url: './api/hub/bots/action',
			payload: { instanceId, action, botId, data: data || {} },
			successMsg: successMsg,
			onSuccess: function() { getActiveBots(); },
			onFailure: function() { setReloadTimeout(); }
		});
	}


	function toggleBotConfirm(instanceId, botId, botName, enable) {

		const action  = enable ? 'bot_enable' : 'bot_disable';
		const btnText = enable ? 'Enable' : 'Disable';
		const btnColor = enable ? '#4aa602' : '#d80f08';

		if (confirmWaiting) return;

		confirmWaiting = true;

		_autoRefresh.stop();

		$.confirm({
			title: false,
			boxWidth: '50%',
			useBootstrap: false,
			content: '<div style="font-size: var(--fs-dialog-title); text-align: left;">' + btnText + ' ' + SymBot.UI.esc(botName) + '?</div>',
			buttons: {
				ok: {
					btnClass: 'btn-default',
					text: '<div style="color: ' + btnColor + ';">' + btnText + ' Bot</div>',
					action: function() {

						$('#spinner-overlay').fadeIn(100);

						$.ajax({
							type: 'POST',
							url: './api/hub/bots/action',
							contentType: 'application/json',
							data: JSON.stringify({ instanceId, action, botId }),
							dataType: 'json',
							success: function(res) {

								$('#spinner-overlay').fadeOut(100);
								confirmWaiting = false;

								if (!res.success) {

									alertBox('Error: ' + (res.data || 'Unknown error'), function() { setReloadTimeout(); });
								}
								else {

									// Update toggle state immediately without waiting for next refresh
									const $row = $('[data-botid="' + botId + '"]');
									$row.attr('data-active', enable);
									$('#toggle' + botId).prop('checked', enable).switchToggle(enable);

									alertBox(SymBot.UI.esc(botName) + ' ' + (enable ? 'enabled' : 'disabled'), function() { setReloadTimeout(); });
								}
							},
							error: function(err) {

								$('#spinner-overlay').fadeOut(100);
								confirmWaiting = false;

								if (err.status === 401) { window.location.href = './login'; return; }

								alertBox('Error: ' + JSON.stringify(err), function() { setReloadTimeout(); });
							}
						});
					}
				},
				cancel: {
					btnClass: 'btn-default',
					text: '<div style="color: #000000;">Cancel</div>',
					action: function() {

						confirmWaiting = false;
						setReloadTimeout();
					}
				}
			}
		});
	}


	function deleteBotConfirm(instanceId, botId, botName) {

		$.confirm({
			title: false,
			boxWidth: '50%',
			useBootstrap: false,
			content: '<div style="font-size: var(--fs-dialog-title); text-align: left;">' +
				'<b style="color: #d80f08;">Delete ' + SymBot.UI.esc(botName) + '?</b><br><br>' +
				'<div style="font-size: var(--fs-body); padding: 8px; background: rgba(255,0,0,0.1); border-left: 3px solid #d80f08; border-radius: 2px;">' +
				'<b>This cannot be undone.</b> The bot and all of its deal history will be permanently deleted. Active deals must be closed or canceled first.' +
				'</div><br>' +
				'Type the bot name to confirm:<br>' +
				'<form action="" style="display: inline;"><input type="text" id="deleteBotConfirmName" class="form-field" style="width: 100%; margin-top: 6px; box-sizing: border-box;" required /></form>' +
				'</div>',
			buttons: {
				confirm: {
					btnClass: 'btn-default',
					text: '<div style="color: #d80f08;">Delete Bot</div>',
					action: function() {

						const typed = this.$content.find('#deleteBotConfirmName').val().trim();

						if (typed !== botName) {

							alertBox('Bot name does not match.');
							return false;
						}

						botAction(instanceId, 'delete', botId, {}, 'Bot "' + SymBot.UI.esc(botName) + '" and all deal history deleted.');
					}
				},
				cancel: {
					btnClass: 'btn-default',
					text: '<div style="color: #000000;">Cancel</div>',
					action: function() { setReloadTimeout(); }
				}
			},
			onContentReady: function() {

				let jc = this;

				this.$content.find('form').on('submit', function(e) {

					e.preventDefault();
					jc.$$confirm.trigger('click');
				});
			}
		});
	}



	function editBot(instanceId, botId) {

		window.location.href = './bots/' + encodeURIComponent(instanceId) + '/' + encodeURIComponent(botId);
	}

	// ── Data fetching and rendering ───────────────────────────────────────────

	function getActiveBots() {

		$.ajax({
			type: 'GET',
			url: './api/hub/bots',
			data: {},
			dataType: 'json',
			success: function(data) {

				populateBots(data.data || []);

				setReloadTimeout();
			},
			error: function(err) {

				if (err.status === 401) { window.location.href = './login'; return; }

				// Don't leave the "Loading…" message hanging behind the alert.
				$('#hubBotsLoadingMsg').text('Could not load bots.');

				alertBox('Error fetching bots: ' + JSON.stringify(err), function() { setReloadTimeout(); });
			}
		});
	}


	function populateBots(bots) {

		const maxPairs     = 8;
		const selectedInst = $('#hub-instance-filter').val();

		let contentArr = [];
		let totalBots  = 0;
		let activeBots = 0;

		for (let i = 0; i < bots.length; i++) {

			const bot          = bots[i];
			const instanceName = bot.instanceName || '';
			const instanceId   = bot.instanceId || '';
			const botId        = bot.botId;
			const botName      = bot.botName;
			const active       = bot.active;
			const sandBox      = bot.sandBox;

			if (!activeInstances.includes(instanceName)) {

				activeInstances.push(instanceName);
				$('#hub-instance-filter').append('<option value="' + SymBot.UI.esc(instanceId) + '">' + SymBot.UI.esc(instanceName) + '</option>');
			}

			if (selectedInst !== 'all' && instanceId !== selectedInst) continue;

			totalBots++;

			if (active) activeBots++;

			// Pairs display
			let pairDisplay = '';

			const pairsArr = typeof bot.pair !== 'string' ? bot.pair : [bot.pair];
			const pairsShow = pairsArr.slice(0, maxPairs);

			pairDisplay = pairsShow.join(', ').toUpperCase();

			if (pairsArr.length > maxPairs) pairDisplay += ' ...';

			const dealMax  = (bot.dealMax  == 0) ? '&#8734;' : bot.dealMax;
			const pairMax  = (bot.pairMax  == 0) ? '&#8734;' : bot.pairMax;
			const botQuote = Array.isArray(bot.pair) ? (bot.pair[0] || '').split('/')[1] : (bot.pair || '').split('/')[1];
			const botSym = getCurrencySymbol(botQuote) || '$';
			const maxFunds = botSym + Math.round(bot.botMaxFunds || bot.maxFunds || 0);

			let startCondition = 'ASAP';

			if (bot.startConditions && bot.startConditions.length > 0) {

				startCondition = bot.startConditions[0].toUpperCase();
			}

			const checkedAttr = active ? 'checked' : '';
			const exchange    = (bot.exchange || '').toUpperCase();

			contentArr.push(
				'<tr data-botid="' + botId + '" data-botname="' + SymBot.UI.esc(botName) + '" data-instanceid="' + instanceId + '" data-instancename="' + SymBot.UI.esc(instanceName) + '" data-active="' + active + '">' +
				'<td>' + SymBot.UI.esc(instanceName) + '</td>' +
				'<td>' + SymBot.UI.esc(botName) + '</td>' +
				'<td>' + SymBot.UI.esc(exchange) + '</td>' +
				'<td style="max-width: 160px;">' + SymBot.UI.esc(pairDisplay) + '</td>' +
				'<td>' + (bot.firstOrderAmount || '') + '</td>' +
				'<td>' + (bot.dcaOrderAmount   || '') + '</td>' +
				'<td>' + (bot.dcaMaxOrder      || '') + '</td>' +
				'<td>' + (bot.dcaTakeProfitPercent || '') + '%</td>' +
				'<td>' + dealMax + '</td>' +
				'<td>' + pairMax + '</td>' +
				'<td>' + maxFunds + '</td>' +
				'<td>' + startCondition + '</td>' +
				'<td>' + (sandBox ? 'Yes' : 'No') + '</td>' +
				'<td><input id="toggle' + botId + '" type=checkbox ' + checkedAttr + ' disabled></td>' +
				'<td style="text-align:center;">' +
				'<div class="pill-group">' +
					'<span class="pill-btn pill-danger" title="Delete Bot" data-action="delete">&#10005;</span>' +
				'</div>' +
			'</td>' +
				'</tr>'
			);
		}

		$('#hubBots tbody').empty().append(contentArr.join(''));

		// Reveal the table only once rows are in place; show a clear message when
		// there are none. Avoids the empty table flashing with collapsed headers
		// during the fetch. Matches the Active Deals loading pattern.
		$('#hubBotsLoadingMsg').hide();

		if (contentArr.length > 0) {

			$('#hubBotsEmptyMsg').hide();
			$('#hubBots').show();
		}
		else {

			$('#hubBots').hide();
			$('#hubBotsEmptyMsg').show();
		}

		$('#totalBots').html(totalBots);
		$('#activeBots').html(activeBots);

		// Re-init simpleSwitch on new rows (read-only — actions via confirm)
		$('[id*="toggle"]').simpleSwitch();
		$('[id*="toggle"]').prop('disabled', true);

		$('#hubBots').trigger('update');

		resizeBotsDeals();
	}


	// ── Document ready ────────────────────────────────────────────────────────

	const getCurrencySymbol = <%- getCurrencySymbol %>;

$(document).ready(function() {

		$(window).resize(function() {

			resizeBotsDeals();
		});


		// Row click handler — clicking any data column navigates to edit page
		$(document).on('click', '#hubBots tbody tr td', function(e) {

			const col        = $(this).index();
			const row        = $(this).closest('tr');
			const colCount   = row.find('td').length;
			const botId      = row.data('botid');
			const botName    = row.data('botname');
			const instanceId = row.data('instanceid');
			const instanceName = row.data('instancename');
			const active     = row.attr('data-active') === 'true';

			// Action buttons column (last) — delete only now
			if (col === colCount - 1) {

				const action = $(e.target).closest('[data-action]').data('action');

				if (action === 'delete') {

					deleteBotConfirm(instanceId, botId, botName);
				}

				return;
			}

			// Enable/disable toggle column (second to last)
			if (col === colCount - 2) {

				toggleBotConfirm(instanceId, botId, botName, !active);
				return;
			}

			// Any other column — navigate to bot edit page
			editBot(instanceId, botId);
		});


		// Create Bot button
		$(document).on('click', '#hubCreateBot', function() {

			const instanceId = $('#hub-instance-filter').val();

			if (!instanceId || instanceId === 'all') {

				alertBox('Please select a specific instance from the Instance filter before creating a bot.');
				return;
			}

			window.location.href = './bots/' + encodeURIComponent(instanceId) + '/create';
		});


		$('#hub-instance-filter').change(() => { getActiveBots(); });


		// Pre-select instance filter from URL param ?instance=:instanceId
		const _urlParams = new URLSearchParams(window.location.search);
		const _preInstance = _urlParams.get('instance');

		if (_preInstance) {

			// Wait for options to populate then set value and refresh
			const _filterInterval = setInterval(function() {

				if ($('#hub-instance-filter option[value="' + _preInstance + '"]').length) {

					$('#hub-instance-filter').val(_preInstance).trigger('change');
					clearInterval(_filterInterval);
				}
			}, 100);

			// Stop polling after 5s in case instance isn't found
			setTimeout(() => clearInterval(_filterInterval), 5000);
		}


		$('#hubBots').tablesorter({
			widgets: ['saveSort', 'stickyHeaders', 'uitheme', 'columnSelector'],
			widgetOptions: {
				saveSort: true,
				stickyHeaders_attachTo: '',
				columnSelector_mediaqueryHidden: true,
				columnSelector_mediaqueryName: 'Show Default',
				columnSelector_container: $('#botDealSelector')
			}
		});

		SymBot.UI.initColumnSelector();
		SymBot.UI.initHeaderCorners('#hubBots');

		initRefreshSelector();

		getActiveBots();
	});

</script>


<center>
<main>

	<%- include('../partialsColumnSelector') %>

	<div id="contentBox" class="wide">

		<div style="position: relative;">

			<div class="contentHeaderBox">

				<b class="contentHeader">Hub Bots</b>

				<span class="viewSettings">
					<select id="hubRefreshInterval" class="form-field" style="width: auto; cursor: pointer;" title="Refresh interval"></select>
					<span id="botDealSelectorShow" class="viewIconBtn"><span class="icon icon-columns" style="width:13px;height:13px;"></span></span>
				</span>
			</div>

			<div class="view-summary">
				<div class="summary-bar">
					<p>Bots: <span id="totalBots"></span></p>
					<p>Active: <span id="activeBots"></span></p>
					<div class="active-filter">
						<p>Instance:</p>
						<select class="form-field" id="hub-instance-filter">
							<option value="all"></option>
						</select>
					</div>
					<button id="hubCreateBot" class="btn-default" style="font-size: var(--fs-body); padding: 3px 10px; cursor: pointer;">+ Create Bot</button>
				</div>
			</div>

			<div class="botsDealsBox" style="margin-top: 20px;">

				<div id="hubBotsLoadingMsg" class="deals-state-msg">Loading bots&hellip;</div>
				<div id="hubBotsEmptyMsg" class="deals-state-msg" style="display: none;">No bots found.</div>

				<table id="hubBots" border=0 cellspacing=0 cellpadding=0 style="display: none;">

				<thead style="position: sticky; top: 0; z-index: 1000;">
					<tr class="tableHeader">
						<th>Instance</th> <th>Bot Name</th> <th>Exchange</th> <th>Pairs</th> <th>BO</th> <th>SO</th> <th>Max SO</th> <th>TP</th> <th>Max Deals</th> <th>Max Pairs</th> <th>Max Funds</th> <th>Start</th> <th>Sandbox</th> <th data-sorter="false" class="columnSelector-disable">Active</th> <th data-sorter="false" class="columnSelector-disable"></th>
					</tr>
				</thead>

				<tbody></tbody>

				</table>
			</div>
		</div>
	</div>

</main>
</center>

<%- include('../partialsFooterView'); %>