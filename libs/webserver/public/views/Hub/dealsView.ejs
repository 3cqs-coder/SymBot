<%- include('../partialsHeaderView'); %>

<script>

	let dealTracker = {};
	let dealTrackerErrors = {};
	let activeBots = [];
	let activeInstances = [];
	let modalId = 'hubDealsView';


	// Shared auto-refresh timer (SymBot.UI owns the timeout internally). The thin local
	// setReloadTimeout / initRefreshSelector wrappers below keep every existing callsite unchanged.
	const _autoRefresh = SymBot.UI.autoRefresh({
		storageKey: 'hubDealsRefreshMs',
		intervals: [ { label: '5s', ms: 5000 }, { label: '15s', ms: 15000 }, { label: '30s', ms: 30000 }, { label: '60s', ms: 60000 }, { label: 'Paused', ms: 0 } ],
		defaultMs: 15000,
		selector: '#hubRefreshInterval',
		onReload: function() { getActiveDeals(); }
	});

	const actionButtons = {
		'cancel': {
			'button': '<span class="pill-btn pill-danger" title="Cancel deal"><span class="icon icon-cancel" style="width:13px;height:13px;pointer-events:none;"></span></span>',
			'tooltip': 'Cancel deal'
		},
		'panic': {
			'button': '<span class="pill-btn" title="Close deal"><span class="icon icon-close" style="width:13px;height:13px;pointer-events:none;"></span></span>',
			'tooltip': 'Close deal'
		},
		'pause': {
			'button': '<span class="pill-btn pill-warn" title="Pause deal"><span class="icon icon-pause" style="width:13px;height:13px;pointer-events:none;"></span></span>',
			'tooltip': 'Pause deal'
		},
		'resume': {
			'button': '<span class="pill-btn pill-warn" title="Resume deal"><span class="icon icon-resume" style="width:13px;height:13px;pointer-events:none;"></span></span>',
			'tooltip': 'Resume deal'
		},
		'stop': {
			'button': '<span class="pill-btn pill-danger" title="Stop bot"><span class="icon icon-stop" style="width:13px;height:13px;pointer-events:none;"></span></span>',
			'tooltip': 'Stop bot'
		}
	};

	const convertBoolean = new Function('return ' + `<%- convertBoolean %>`)();


	// ── Refresh management (delegates to SymBot.UI.autoRefresh; see _autoRefresh above) ──
	function setReloadTimeout() { _autoRefresh.schedule(); }
	function initRefreshSelector() { _autoRefresh.initSelector(); }


	// ── Deal actions ──────────────────────────────────────────────────────────

	// Both delegate to SymBot.UI.postAction (spinner + POST + 401→login + alertBox); each just supplies
	// its url/payload and resumes auto-refresh when the alert is dismissed.
	function dealAction(instanceId, action, dealId, botId, data, successMsg) {
		SymBot.UI.postAction({
			url: './api/hub/deals/' + dealId + '/action',
			payload: { instanceId, action, botId, data: data || {} },
			successMsg: successMsg,
			onSuccess: function() { setReloadTimeout(); }
		});
	}


	function botAction(instanceId, action, botId, successMsg) {
		SymBot.UI.postAction({
			url: './api/hub/bots/' + botId + '/action',
			payload: { instanceId, action },
			successMsg: successMsg,
			onSuccess: function() { setReloadTimeout(); }
		});
	}


	// ── Confirm dialogs ───────────────────────────────────────────────────────

	function panicSellConfirm(instanceId, dealId) {

		let randNum = Math.floor(1000 + Math.random() * 9000);

		_autoRefresh.stop();

		$.confirm({
			title: false,
			boxWidth: '50%',
			useBootstrap: false,
			content: '<div style="font-size: var(--fs-dialog-title); text-align: left;">Close deal ' + dealId + ' at current market price?<br><br>' +
				'Type <b>' + randNum + '</b> to confirm: ' +
				'<form action="" style="display: inline;"><input type="text" id="confirmNum" class="form-field" onkeypress="if (event.which < 48 || event.which > 57) if (event.which != 8) return false;" required /></form></div>',
			buttons: {
				formSubmit: {
					btnClass: 'btn-default',
					text: '<div style="color: #d80f08;">Close Deal</div>',
					action: function() {

						const confirmNum = this.$content.find('#confirmNum').val();

						if (!confirmNum || confirmNum != randNum) {

							alertBox('Confirmation number incorrect');
							return false;
						}

						dealAction(instanceId, 'panic_sell', dealId, null, {}, 'Deal ' + dealId + ' close requested');
					}
				},
				cancel: {
					btnClass: 'btn-default',
					text: '<div style="color: #000000;">Cancel</div>',
					action: function() { setReloadTimeout(); }
				}
			},
			onContentReady: function() {

				let jc = this;

				this.$content.find('form').on('submit', function(e) {

					e.preventDefault();
					jc.$$formSubmit.trigger('click');
				});
			}
		});
	}


	function cancelDealConfirm(instanceId, dealId, pair) {

		_autoRefresh.stop();

		$.confirm({
			title: false,
			boxWidth: '50%',
			useBootstrap: false,
			content: '<div style="font-size: var(--fs-dialog-title); text-align: left;">Cancel deal ' + dealId + '?<br><br>' +
				'This will cancel the deal without selling assets already bought.<br><br>' +
				'<input type="checkbox" id="confirmBox" class="form-field" style="width: 20px;" /> <b>Check to confirm <span style="color: #d80f08;">CANCEL</span> deal</b></div>',
			buttons: {
				formSubmit: {
					btnClass: 'btn-default',
					text: '<div style="color: #d80f08;">Cancel Deal</div>',
					action: function() {

						if (!$('#confirmBox').prop('checked')) {

							alertBox('You must check the box to confirm');
							return false;
						}

						dealAction(instanceId, 'cancel', dealId, null, {}, 'Deal ' + dealId + ' canceled');
					}
				},
				cancel: {
					btnClass: 'btn-default',
					text: '<div style="color: #000000;">Cancel</div>',
					action: function() { setReloadTimeout(); }
				}
			},
			onContentReady: function() {

				$('#confirmBox').prop('checked', false);
			}
		});
	}


	function pauseDealConfirm(instanceId, dealId, pair, botId, pause, pauseBuy, pauseSell, pauseReason) {

		// Same system-pause caution the instance view shows, via the shared SymBot.UI.systemPauseInfo helper —
		// so a maintainer resuming an automatically-paused deal from the Hub gets the same warning.
		const pauseInfo = SymBot.UI.systemPauseInfo(pauseReason || '');
		const systemWarning = pauseInfo.isSystem
			? '<div style="font-size: var(--fs-body); padding: 8px; margin-bottom: 10px; background: rgba(255,140,0,0.15); border-left: 3px solid #ffa000; border-radius: 2px;">' +
			  '<b>⚠ System paused:</b> This deal was automatically paused by the system due to ' + pauseInfo.description + '. ' +
			  'Review the situation before resuming manually.</div>'
			: '';

		_autoRefresh.stop();

		$.confirm({
			title: false,
			boxWidth: '50%',
			useBootstrap: false,
			content: '<div style="font-size: var(--fs-dialog-title); text-align: left;">' + systemWarning + 'Pause / Resume deal ' + dealId + '?<br><br>' +
				'<form action="" style="display: inline;">' +
				'<input id="dealPauseBuy" type=checkbox class="form-field"> &nbsp; <b>Pause Buy</b><br>' +
				'<input id="dealPauseSell" type=checkbox class="form-field"> &nbsp; <b>Pause Sell</b><br><br>' +
				'<input type="checkbox" id="confirmBox" class="form-field" style="width: 20px;" /> <b>Check to confirm <span style="color: #d80f08;">PAUSE / RESUME</span></b>' +
				'</form></div>',
			buttons: {
				formSubmit: {
					btnClass: 'btn-default',
					text: '<div style="color: #d80f08;">Pause / Resume Deal</div>',
					action: function() {

						if (!$('#confirmBox').prop('checked')) {

							alertBox('You must check the box to confirm');
							return false;
						}

						const pb = convertBoolean($('#dealPauseBuy').prop('checked'), false);
						const ps = convertBoolean($('#dealPauseSell').prop('checked'), false);

						dealAction(instanceId, 'pause', dealId, botId, { pauseBuy: pb, pauseSell: ps }, 'Deal ' + dealId + ' pause updated');
					}
				},
				cancel: {
					btnClass: 'btn-default',
					text: '<div style="color: #000000;">Cancel</div>',
					action: function() { setReloadTimeout(); }
				}
			},
			onOpenBefore: function() {

				if (pause) { pauseBuy = true; pauseSell = true; }

				$('#dealPauseBuy').simpleSwitch();
				$('#dealPauseSell').simpleSwitch();
				$('#dealPauseBuy').prop('checked', pauseBuy).switchToggle(pauseBuy);
				$('#dealPauseSell').prop('checked', pauseSell).switchToggle(pauseSell);
			},
			onContentReady: function() {

				$('#confirmBox').prop('checked', false);
			}
		});
	}


	function stopBotConfirm(instanceId, botId, botName) {

		_autoRefresh.stop();

		$.confirm({
			title: false,
			boxWidth: '50%',
			useBootstrap: false,
			content: '<div style="font-size: var(--fs-dialog-title); text-align: left;">Disable ' + SymBot.UI.esc(botName) + '? Current deals will continue running until they complete.</div>',
			buttons: {
				ok: {
					btnClass: 'btn-default',
					text: '<div style="color: #d80f08;">Disable Bot</div>',
					action: function() {

						botAction(instanceId, 'bot_disable', botId, SymBot.UI.esc(botName) + ' disabled');
					}
				},
				cancel: {
					btnClass: 'btn-default',
					text: '<div style="color: #000000;">Cancel</div>',
					action: function() { setReloadTimeout(); }
				}
			}
		});
	}


	// ── Data fetching and rendering ───────────────────────────────────────────

	function getActiveDeals() {

		$.ajax({
			type: 'GET',
			url: './api/hub/deals',
			data: {},
			dataType: 'json',
			success: function(data) {

				populateDeals(data.date, data.data || []);

				setReloadTimeout();
			},
			error: function(err) {

				if (err.status === 401) { window.location.href = './login'; return; }

				alertBox('Error fetching deals: ' + JSON.stringify(err), function() { setReloadTimeout(); });
			}
		});
	}


	function populateDeals(date, deals) {

		const maxMins = 2;

		let totalProfit = 0;
		let activeDeals = 0;
		let inDeals = 0;
		let dealDataErrors = 0;

		const selectedBot      = $('#hub-bot-filter').val();
		const selectedInstance = $('#hub-instance-filter').val();

		let msgBox = '';
		let dealsErrorArr = [];
		let contentArr = [];

		dealTracker = {};

		// Strip any invalid options that may have been added in previous cycles
		$('#hub-bot-filter option').filter(function() {
			const v = $(this).val();
			return v && v !== 'all' && (!v || v === 'undefined' || v === 'null' || v.trim() === '');
		}).remove();

		$('#hub-instance-filter option').filter(function() {
			const v = $(this).val();
			return v && v !== 'all' && (!v || v === 'undefined' || v === 'null' || v.trim() === '');
		}).remove();

		for (let i = 0; i < deals.length; i++) {

			const deal         = deals[i];
			const instanceName = deal.instanceName || '';
			const instanceId   = deal.instanceId || '';
			const config       = deal['config'];
			const dealId       = deal['dealId'];
			const pause        = deal['info']['pause'];
			const pauseBuy     = deal['info']['pause_buy'];
			const pauseSell    = deal['info']['pause_sell'];
			const pauseReason  = deal['info']['pause_reason'] || '';
			// System-paused (an automatic pause from an order/verify error) is surfaced the same way as the
			// instance view — a translucent amber row tint here, and a caution in the pause dialog — via the
			// single shared SymBot.UI.systemPauseInfo helper, so both surfaces stay in lockstep.
			const isSystemPaused = SymBot.UI.systemPauseInfo(pauseReason).isSystem;
			const dealError    = deal['info']['error'];
			const lastUpdated  = deal['info']['updated'];
			const botActive    = deal['info']['bot_active'];
			const profit       = deal['info']['profit'];
			const profitPerc   = deal['info']['profit_percentage'];
			const botId        = deal['info']['bot_id'];
			const botName      = deal['info']['bot_name'];
			// A just-resumed deal on that instance whose live figures haven't arrived yet: show it now with
			// "updating…" live cells and a neutral pending health dot, identical to the instance view.
			const awaiting     = !!deal['info']['awaiting_live'];

			// Populate filter dropdowns (once per unique value)
			if (botName && botName !== 'undefined' && !activeBots.includes(botName)) {

				activeBots.push(botName);
				$('#hub-bot-filter').append('<option value="' + SymBot.UI.esc(botName) + '">' + SymBot.UI.esc(botName) + '</option>');
			}

			if (instanceName && instanceName !== 'undefined' && !activeInstances.includes(instanceName)) {

				activeInstances.push(instanceName);
				$('#hub-instance-filter').append('<option value="' + SymBot.UI.esc(instanceName) + '">' + SymBot.UI.esc(instanceName) + '</option>');
			}

			// Apply filters
			if (selectedBot      !== 'all' && botName      !== selectedBot)      continue;
			if (selectedInstance !== 'all' && instanceName !== selectedInstance) continue;

			activeDeals++;

			// Deal data error handling
			if (isNaN(deal['info']['deal_count']) || (dealError != undefined && dealError != null && dealError != '')) {

				const maxSec = 30;

				if (!dealTrackerErrors[dealId]) {

					dealTrackerErrors[dealId] = { date: new Date() };
					continue;
				}
				else {

					const diffSec = (new Date().getTime() - new Date(dealTrackerErrors[dealId].date).getTime()) / 1000;

					if (diffSec <= maxSec) continue;

					dealDataErrors++;
				}
			}
			else {

				delete dealTrackerErrors[dealId];
			}

			const dealVolume = SymBot.UI.dealVolume(deal['orders']);

			inDeals += dealVolume;

			if (!isNaN(profit)) totalProfit += profit;

			// Stale deal check
			if (SymBot.UI.isDealStale(date, lastUpdated, maxMins)) {

				dealsErrorArr.push(dealId);
			}

			// Shared common shape + the Hub-only instance/pair fields on top.
			dealTracker[dealId] = Object.assign(SymBot.UI.buildDealTrackerEntry(deal), {
				instanceId:   instanceId,
				instanceName: instanceName,
				pair:         deal['pair']
			});

			// Button state
			let { cancel: { button: cancelBtn }, panic: { button: panicBtn },
			      pause:  { button: pauseBtn },  stop:  { button: stopBtn } } = actionButtons;

			if (pause || pauseBuy || pauseSell) {

				pauseBtn = actionButtons['resume']['button'];
			}

			if (!botActive) {

				stopBtn = SymBot.UI.disabledStopButton();
			}

			const profitPercClass = awaiting ? '' : (profitPerc <= 0 ? 'profit-negative' : 'profit-positive');

			let dealMax = deal['info']['deal_max'];

			if (dealMax == 0) dealMax = '&#8734;';

			const dealCount  = deal['info']['deal_count'] + ' / ' + dealMax;
			const duration   = timeDiff(new Date(), new Date(deal['date']));
			const safetyUsed = deal['info']['safety_orders_used'];
			const safetyMax  = config['dcaMaxOrder'];
			// USER Add-Funds additions shown as "(+N)" — same shared helper the instance list uses, so both
			// surfaces agree (an auto partial-fill-credit re-uses a slot and is not an addition).
			const addedFunds = SymBot.UI.addedFundsCount(deal['orders']);
			const safetyMaxDisplay = safetyMax + (addedFunds > 0 ? ' (+' + addedFunds + ')' : '');
			const priceLast  = deal['info']['price_last'];
			const priceTarget = deal['info']['price_target'];
			const dealSym = getDealSym(deal['pair'], deal['config']['profitCurrency']);

			// Stop-loss annotation for the Target cell (#104a) — shared helper keeps it identical to the
			// instance view.
			const stopLossDisplay = SymBot.UI.stopLossCell(deal['info'], dealSym, convertNotation);

			const pillContent = panicBtn + pauseBtn + cancelBtn + (stopBtn || '');

			// Live health glyph (shared with the instance view via SymBot.UI).
			const healthCell = SymBot.UI.dealHealthCell({
				profitPerc: profitPerc,
				soUsed: safetyUsed,
				soMax: safetyMax,
				hasError: !!dealError,
				isPaused: !!(pause || pauseBuy || pauseSell),
				awaiting: awaiting
			});

			contentArr.push(
				'<tr style="background-color: ' + (isSystemPaused ? 'rgba(255,140,0,0.22)' : '') + ';" data-dealid="' + dealId + '" data-pair="' + SymBot.UI.esc(deal['pair']) + '" data-instanceid="' + instanceId + '" data-botid="' + botId + '" data-botname="' + SymBot.UI.esc(botName) + '" data-exchange="' + SymBot.UI.esc(config['exchange'] || '') + '">' +
				healthCell +
				'<td>' + SymBot.UI.esc(instanceName) + '</td>' +
				'<td>' + SymBot.UI.esc(botName) + '</td>' +
				'<td>' + SymBot.UI.esc(deal['pair']) + '</td>' +
				'<td>' + duration + '</td>' +
				'<td>' + SymBot.UI.pendingCell(awaiting, dealSym + convertNotation(priceLast)) + '</td>' +
				'<td>' + dealSym + convertNotation(priceTarget) + stopLossDisplay + '</td>' +
				'<td>' + dealSym + dealVolume.toFixed(2) + '</td>' +
				'<td class="' + profitPercClass + '">' + SymBot.UI.pendingCell(awaiting, dealSym + profit) + '</td>' +
				'<td class="' + profitPercClass + '">' + SymBot.UI.pendingCell(awaiting, profitPerc + '%') + '</td>' +
				'<td>' + safetyUsed + ' / ' + safetyMaxDisplay + '</td>' +
				'<td>' + dealCount + '</td>' +
				'<td style="text-align: center;" data-pause="' + pause + '" data-pausebuy="' + pauseBuy + '" data-pausesell="' + pauseSell + '" data-pausereason="' + SymBot.UI.esc(pauseReason) + '">' +
				'<div class="pill-group" id="actions' + dealId + i + '">' + pillContent + '</div></td>' +
				'</tr>'
			);
		}

		// Warnings
		if (dealsErrorArr.length > 0) {

			msgBox += '<div>WARNING: ' + dealsErrorArr.length + ' deal(s) exceed last updated time of ' + maxMins + ' minutes.</div>';
		}

		if (dealDataErrors > 0) {

			msgBox += '<div>WARNING: ' + dealDataErrors + ' deal(s) have errors or invalid data.</div>';
		}

		$('#msgBox').html(msgBox ? '<div style="color: #386ec2;">' + msgBox + '</div>' : '');
		$('#hubDeals tbody').empty().append(contentArr.join(''));

		// Show the table only when there are rows to display; otherwise show a
		// clear "no active deals" message. This avoids the empty table rendering
		// with collapsed headers during load or when there are no deals.
		$('#dealsLoadingMsg').hide();

		if (contentArr.length > 0) {

			$('#dealsEmptyMsg').hide();
			$('#hubDeals').show();
		}
		else {

			$('#hubDeals').hide();
			$('#dealsEmptyMsg').show();
		}

		$('#totalProfit').removeClass('profit-positive profit-negative')
			.addClass(totalProfit <= 0 ? 'profit-negative' : 'profit-positive')
			.html((deals.length > 0 ? getDealSym(deals[0]['pair'], deals[0]['config']['profitCurrency']) : '$') + totalProfit.toFixed(2));

		$('#inDeals').html((deals.length > 0 ? getDealSym(deals[0]['pair'], deals[0]['config']['profitCurrency']) : '$') + inDeals.toFixed(2));
		$('#totalDeals').html(activeDeals);

		$('#hubDeals').trigger('update');

		resizeBotsDeals();
	}


	// ── Document ready ────────────────────────────────────────────────────────

	const getCurrencySymbol = <%- getCurrencySymbol %>;

function getDealSym(pair, profitCurrency) { return SymBot.UI.dealSymbol(pair, profitCurrency, getCurrencySymbol); }


$(document).ready(function() {

		// Shared hover-tooltip machinery (SymBot.UI). Here an id matches an action key by prefix.
		SymBot.UI.initTooltips({ resolve: function(id) {
			for (let key in actionButtons) { if (id && id.startsWith(key)) { return actionButtons[key]['tooltip']; } }
			return null;
		}});

		$(window).resize(function() {

			resizeBotsDeals();
		});


		// Pill button clicks
		$(document).on('click', '#hubDeals .pill-btn', function(e) {

			e.stopPropagation();

			const $btn       = $(this);
			const $td        = $btn.closest('td');
			const row        = $btn.closest('tr');
			const dealId     = row.data('dealid');
			const pair       = row.data('pair');
			const instanceId = row.data('instanceid');
			const botId      = row.data('botid');
			const botName    = row.data('botname');
			const btnTitle   = $btn.attr('title');
			const pause      = $td.data('pause');
			const pauseBuy   = $td.data('pausebuy');
			const pauseSell  = $td.data('pausesell');
			const pauseReason = $td.data('pausereason') || '';

			if (btnTitle === 'Close deal') {

				if (dealId) panicSellConfirm(instanceId, dealId);
			}
			else if (btnTitle === 'Pause deal' || btnTitle === 'Resume deal') {

				if (dealId) pauseDealConfirm(instanceId, dealId, pair, botId, pause, pauseBuy, pauseSell, pauseReason);
			}
			else if (btnTitle === 'Cancel deal') {

				if (dealId) cancelDealConfirm(instanceId, dealId, pair);
			}
			else if (btnTitle === 'Stop bot') {

				if (botId) stopBotConfirm(instanceId, botId, botName);
			}
		});


		// Row click — col 3 (Pair) opens TradingView, any other data col opens order history
		$(document).on('click', '#hubDeals tbody tr td', function() {

			const col      = $(this).index();
			const row      = $(this).closest('tr');
			const colCount = row.find('td').length;
			const dealId   = row.data('dealid');

			// Last column is actions — skip
			if (col >= colCount - 1) return;

			if (col === 3) {

				// Pair column — open the deal chart (col 0 is Health). Falls back to the plain
				// TradingView widget if the shared chart component is unavailable.
				const pair     = $(this).text().trim();
				const exchange = row.attr('data-exchange') || '';

				if (pair && exchange) {

					if (window.SymBot && SymBot.DealChart) {

						SymBot.DealChart.open(dealId, { 'modalId': modalId, 'pair': pair, 'exchange': exchange });
					}
					else {

						showTradingView(modalId, 'modal', false, false, pair, exchange);
					}
				}
			}
			else {

				// Any other data column — order history
				if (!dealTracker[dealId]) return;

				showOrderHistory(modalId, dealId, dealTracker[dealId]['info']['active'], dealTracker[dealId]['orders'], dealTracker[dealId]['pair']);
			}
		});


		$('#hub-bot-filter').change(() => { getActiveDeals(); });
		$('#hub-instance-filter').change(() => { getActiveDeals(); });


		// Pre-select instance filter from URL param ?instance=:instanceName
		const _urlParams = new URLSearchParams(window.location.search);
		const _preInstance = _urlParams.get('instance');

		if (_preInstance) {

			// Wait for options to populate then set value and refresh
			const _filterInterval = setInterval(function() {

				if ($('#hub-instance-filter option[value="' + _preInstance + '"]').length) {

					$('#hub-instance-filter').val(_preInstance).trigger('change');
					clearInterval(_filterInterval);
				}
			}, 100);

			// Stop polling after 5s in case instance isn't found
			setTimeout(() => clearInterval(_filterInterval), 5000);
		}


		$('#hubDeals').tablesorter({
			widgets: ['saveSort', 'stickyHeaders', 'uitheme', 'columnSelector'],
			widgetOptions: {
				saveSort: true,
				stickyHeaders_attachTo: '',
				columnSelector_mediaqueryHidden: true,
				columnSelector_mediaqueryName: 'Show Default',
				columnSelector_container: $('#botDealSelector')
			},
			durationLength: 4,
			durationLabels: '(?:years|year|y),(?:days|day|d),(?:hours|hour|h),(?:minutes|minute|min|m),(?:seconds|second|sec|s)',
			textExtraction: {
				0: function(node) {
					// Sort the Health column by its numeric rank, not the emoji.
					return node.getAttribute('data-health-rank') || '0';
				}
			},
			headers: {
				4: { sorter: 'duration' },
				5: { sorter: 'currency' },
				6: { sorter: 'currency' },
				7: { sorter: 'currency' },
				8: { sorter: 'currency' }
			}
		});

		SymBot.UI.initColumnSelector();
		SymBot.UI.initHeaderCorners('#hubDeals');

		initRefreshSelector();

		getActiveDeals();
	});

</script>


