<%- include('./partialsHeaderView'); %>

<main>

	<div id="contentBox" class="home-welcome">

		<h1 class="home-welcome-title">Welcome to <%= appData.name_display || appData.name %></h1>
		<p class="home-welcome-sub">Choose a destination from the navigation, or jump straight in:</p>

		<div id="homeHealthStrip" class="home-health-strip home-health-strip-hidden">
			<span class="home-health-item"><span class="home-health-label" id="homeMemLabel">Memory</span> <span id="homeMem" class="home-health-val">—</span></span>
			<span class="home-health-sep">·</span>
			<span class="home-health-item"><span class="home-health-label">Load</span> <span id="homeLoad" class="home-health-val">—</span></span>
			<span class="home-health-sep">·</span>
			<span class="home-health-item"><span class="home-health-label">Uptime</span> <span id="homeUptime" class="home-health-val">—</span></span>
			<span class="home-health-sep">·</span>
			<span class="home-health-item"><span class="home-health-label">Active Deals</span> <span id="homeActiveDeals" class="home-health-val">—</span></span>
		</div>

		<div class="home-quick-grid">
			<a class="home-quick-card" href="./dashboard">
				<span class="home-quick-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg></span>
				<span class="home-quick-label">Dashboard</span>
			</a>
			<a class="home-quick-card" href="./deals/active">
				<span class="home-quick-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l3 8 4-16 3 8h4"/></svg></span>
				<span class="home-quick-label">Active Deals</span>
			</a>
			<a class="home-quick-card" href="./bots">
				<span class="home-quick-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="8" width="16" height="12" rx="2"/><path d="M12 8V4M9 4h6"/><circle cx="9" cy="14" r="1"/><circle cx="15" cy="14" r="1"/></svg></span>
				<span class="home-quick-label">Manage Bots</span>
			</a>
			<a class="home-quick-card" href="./bots/create">
				<span class="home-quick-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg></span>
				<span class="home-quick-label">Create Bot</span>
			</a>
		</div>

	</div>

</main>

<script>

	function loadHomeHealth() {

		$.ajax({
					type: 'GET',
					url: './api/system/health',
					dataType: 'json',
					success: function(res) {

						if (!res || !res.data) { return; }

						const d = res.data;
						const mem = d.memory || {};

						$('#homeUptime').text(d.started ? timeDiff(new Date(d.started), new Date()) : '—');
						$('#homeMemLabel').text('Memory (' + (mem.primary_label || 'RSS') + ')');
						$('#homeMem').text(mem.primary_mb != null ? mem.primary_mb.toLocaleString() + ' MB' : '—');
						$('#homeActiveDeals').text(d.active_deals != null ? d.active_deals : '—');

						// Load as "% of cores" (see System Tools). Color-coded to match.
						const load = d.load_avg;
						const cores = d.cpu_count;

						if (Array.isArray(load) && load.length >= 1 && cores > 0) {

							const loadPct = Math.min(999, Math.round((load[0] / cores) * 100));
							const loadClass = loadPct >= 90 ? 'health-load-high' : (loadPct >= 70 ? 'health-load-med' : 'health-load-low');

							$('#homeLoad').text(loadPct + '%')
								.removeClass('health-load-low health-load-med health-load-high')
								.addClass(loadClass);
						}
						else {

							$('#homeLoad').text('—').removeClass('health-load-low health-load-med health-load-high');
						}

						$('#homeHealthStrip').removeClass('home-health-strip-hidden');
					}
		});
	}


	$(document).ready(function() {

		loadHomeHealth();
		setInterval(loadHomeHealth, 30000);
	});

</script>


<%- include('./partialsFooterView'); %>
